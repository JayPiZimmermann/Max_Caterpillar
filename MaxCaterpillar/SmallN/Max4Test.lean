import MaxCaterpillar.SmallN.Max4Test.Cells0

/-! # `Max4Test`: an exact expansion of `max_4` with 3
caterpillar functions

Generated by `scripts/smalln/gen_lean.py` from `scripts/smalln/inputs/max4_smallarity.json`; do not edit.
Source of the data: MaxCaterpillar/SmallArity.lean, max_four_identity (pipeline test).

The identity is proved on 28 closed polyhedral cells inside 24 braid chambers. -/

set_option autoImplicit false
set_option linter.unusedVariables false

namespace MaxCaterpillar.SmallN.Max4Test

open MaxCaterpillar.SmallN

/-- Every point lies in a cell: the braid chambers are covered by an
insertion-sort tree of `le_total` splits, each chamber by its own tree. -/
theorem identity (x : Point 4) : Maximum 4 x = rhs x := by
  rcases le_total (x 0) (x 1) with h1 | h1
  · rcases le_total (x 1) (x 2) with h2 | h2
    · rcases le_total (x 2) (x 3) with h3 | h3
      · exact chamber0 x h1 h2 h3
      · rcases le_total (x 1) (x 3) with h4 | h4
        · exact chamber1 x h1 h4 h3
        · rcases le_total (x 0) (x 3) with h5 | h5
          · exact chamber2 x h5 h4 h2
          · exact chamber3 x h5 h1 h2
    · rcases le_total (x 0) (x 2) with h6 | h6
      · rcases le_total (x 1) (x 3) with h7 | h7
        · exact chamber4 x h6 h2 h7
        · rcases le_total (x 2) (x 3) with h8 | h8
          · exact chamber5 x h6 h8 h7
          · rcases le_total (x 0) (x 3) with h9 | h9
            · exact chamber6 x h9 h8 h2
            · exact chamber7 x h9 h6 h2
      · rcases le_total (x 1) (x 3) with h10 | h10
        · exact chamber8 x h6 h1 h10
        · rcases le_total (x 0) (x 3) with h11 | h11
          · exact chamber9 x h6 h11 h10
          · rcases le_total (x 2) (x 3) with h12 | h12
            · exact chamber10 x h12 h11 h1
            · exact chamber11 x h12 h6 h1
  · rcases le_total (x 0) (x 2) with h13 | h13
    · rcases le_total (x 2) (x 3) with h14 | h14
      · exact chamber12 x h1 h13 h14
      · rcases le_total (x 0) (x 3) with h15 | h15
        · exact chamber13 x h1 h15 h14
        · rcases le_total (x 1) (x 3) with h16 | h16
          · exact chamber14 x h16 h15 h13
          · exact chamber15 x h16 h1 h13
    · rcases le_total (x 1) (x 2) with h17 | h17
      · rcases le_total (x 0) (x 3) with h18 | h18
        · exact chamber16 x h17 h13 h18
        · rcases le_total (x 2) (x 3) with h19 | h19
          · exact chamber17 x h17 h19 h18
          · rcases le_total (x 1) (x 3) with h20 | h20
            · exact chamber18 x h20 h19 h13
            · exact chamber19 x h20 h17 h13
      · rcases le_total (x 0) (x 3) with h21 | h21
        · exact chamber20 x h17 h1 h21
        · rcases le_total (x 1) (x 3) with h22 | h22
          · exact chamber21 x h17 h22 h21
          · rcases le_total (x 2) (x 3) with h23 | h23
            · exact chamber22 x h23 h22 h1
            · exact chamber23 x h23 h17 h1

/-- **The identity, explicitly.** -/
theorem max_identity (x : Point 4) :
    Maximum 4 x =
      -relu (-x 0 + x 1 + x 2 - x 3 + relu (x 0 - x 1))
      + relu (-x 0 + x 1 + x 2 - x 3 + relu (x 0 - x 1) + relu (x 0 - x 2))
      + relu (-x 1 + x 3 + relu (x 0 - x 2) + relu (x 2 - x 3))
      + x 1
      - relu (x 0 - x 2) :=
  identity x

/-! ## The network -/

set_option linter.unnecessarySeqFocus false
set_option linter.unreachableTactic false

theorem cv0 (a0 a1 a2 a3 : ℚ) : (![a0, a1, a2, a3] : Fin 4 → ℚ) 0 = a0 := rfl

theorem cv1 (a0 a1 a2 a3 : ℚ) : (![a0, a1, a2, a3] : Fin 4 → ℚ) 1 = a1 := rfl

theorem cv2 (a0 a1 a2 a3 : ℚ) : (![a0, a1, a2, a3] : Fin 4 → ℚ) 2 = a2 := rfl

theorem cv3 (a0 a1 a2 a3 : ℚ) : (![a0, a1, a2, a3] : Fin 4 → ℚ) 3 = a3 := rfl

/-- Neuron 0. -/
noncomputable def u0 : Neuron 4 := ⟨-1, ![(-1 : ℚ), 1, 1, (-1 : ℚ)], [(1, 0, 1)]⟩

theorem u0_eval (x : Point 4) :
    (u0.coef : ℝ) * relu (u0.arg x) =
      -relu (-x 0 + x 1 + x 2 - x 3 + relu (x 0 - x 1)) := by
  have h : u0.arg x = -x 0 + x 1 + x 2 - x 3 + relu (x 0 - x 1) := by
    simp [u0, Neuron.arg, Fin.sum_univ_four, cv0, cv1, cv2, cv3] <;> ring
  rw [h]
  simp only [u0]
  push_cast
  ring

/-- Neuron 1. -/
noncomputable def u1 : Neuron 4 := ⟨1, ![(-1 : ℚ), 1, 1, (-1 : ℚ)], [(1, 0, 1), (1, 0, 2)]⟩

theorem u1_eval (x : Point 4) :
    (u1.coef : ℝ) * relu (u1.arg x) =
      relu (-x 0 + x 1 + x 2 - x 3 + relu (x 0 - x 1) + relu (x 0 - x 2)) := by
  have h : u1.arg x = -x 0 + x 1 + x 2 - x 3 + relu (x 0 - x 1) + relu (x 0 - x 2) := by
    simp [u1, Neuron.arg, Fin.sum_univ_four, cv0, cv1, cv2, cv3] <;> ring
  rw [h]
  simp only [u1]
  push_cast
  ring

/-- Neuron 2. -/
noncomputable def u2 : Neuron 4 := ⟨1, ![0, (-1 : ℚ), 0, 1], [(1, 0, 2), (1, 2, 3)]⟩

theorem u2_eval (x : Point 4) :
    (u2.coef : ℝ) * relu (u2.arg x) =
      relu (-x 1 + x 3 + relu (x 0 - x 2) + relu (x 2 - x 3)) := by
  have h : u2.arg x = -x 1 + x 3 + relu (x 0 - x 2) + relu (x 2 - x 3) := by
    simp [u2, Neuron.arg, Fin.sum_univ_four, cv0, cv1, cv2, cv3] <;> ring
  rw [h]
  simp only [u2]
  push_cast
  ring

noncomputable def neurons : List (Neuron 4) := [u0, u1, u2]

def auxTerms : List (ℚ × AuxTerm 4) :=
  [(1, .lin 1), (-1, .pair 0 2)]

theorem expansionEval_eq (x : Point 4) : expansionEval neurons auxTerms x = rhs x := by
  simp only [expansionEval, neurons, auxTerms, List.map_cons, List.map_nil, List.sum_cons,
    List.sum_nil, AuxTerm.eval, u0_eval, u1_eval, u2_eval]
  unfold rhs
  push_cast
  ring

/-- **Network.**  The paper's first hidden layer (`firstWidth 4` neurons) and
5 neurons in the second hidden layer (3 caterpillar functions and two for the
linear remainder); rational weights, zero biases. -/
theorem max_network :
    ∃ net : Network 4 (firstWidth 4) 5,
      (∀ x, net.eval x = Maximum 4 x) ∧ net.HasRationalWeights ∧ net.HasZeroBiases :=
  network_of_expansion (n := 3) neurons auxTerms
    (fun x => (identity x).trans (expansionEval_eq x).symm)

end MaxCaterpillar.SmallN.Max4Test
