    Maximum 5 x = rhs x := by
  rw [max_eq x 3 (by linarith only [c0, c1, c2, c3]) (by linarith only [c3]) (by linarith only [c1, c2, c3]) (le_refl _) (by linarith only [c2, c3])]
  have q0 : relu (x 0 - x 3) = 0 :=
    relu_eq_zero (by linarith only [c0, c1, c2, c3])
  have q1 : relu (x 0 - x 4) = 0 :=
    relu_eq_zero (by linarith only [c0, c1])
  have q2 : relu (x 2 - x 4) = 0 :=
