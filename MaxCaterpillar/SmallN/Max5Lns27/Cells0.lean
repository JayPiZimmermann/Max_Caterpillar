theorem chamber5 (x : Point 5)
    (c0 : x 0 ≤ x 1) (c1 : x 1 ≤ x 3) (c2 : x 3 ≤ x 2) (c3 : x 2 ≤ x 4) :
    Maximum 5 x = rhs x := by
  rw [max_eq x 4 (by linarith only [c0, c1, c2, c3]) (by linarith only [c1, c2, c3]) (by linarith only [c3]) (by linarith only [c2, c3]) (le_refl _)]
  have q0 : relu (x 0 - x 3) = 0 :=
    relu_eq_zero (by linarith only [c0, c1])
  have q1 : relu (x 0 - x 4) = 0 :=
    relu_eq_zero (by linarith only [c0, c1, c2, c3])
  have q2 : relu (x 2 - x 4) = 0 :=
    relu_eq_zero (by linarith only [c3])
  have q3 : relu (x 1 - x 3) = 0 :=
    relu_eq_zero (by linarith only [c1])
  have q4 : relu (x 1 - x 4) = 0 :=
    relu_eq_zero (by linarith only [c1, c2, c3])
  have q5 : relu (x 0 - x 2) = 0 :=
    relu_eq_zero (by linarith only [c0, c1, c2])
  have q6 : relu (x 0 - x 1) = 0 :=
    relu_eq_zero (by linarith only [c0])
  rcases le_total 0 (-x 0 + x 2 + x 3 - x 4) with s0 | s0
  · rcases le_total 0 (-x 0 + x 1 + x 2 - x 4) with s1 | s1
    · rcases le_total 0 (-x 1 + x 2 + x 3 - x 4) with s2 | s2
      · exact cell5_0 x c0 c1 c2 c3 s0 s1 s2 q0 q1 q2 q3 q4 q5 q6
      · exact cell5_1 x c0 c1 c2 c3 s0 s1 s2 q0 q1 q2 q3 q4 q5 q6
    · rcases le_total 0 (-x 1 + x 2 + x 3 - x 4) with s2 | s2
      · exact cell5_2 x c0 c1 c2 c3 s0 s1 s2 q0 q1 q2 q3 q4 q5 q6
      · exact cell5_3 x c0 c1 c2 c3 s0 s1 s2 q0 q1 q2 q3 q4 q5 q6
  · exact cell5_4 x c0 c1 c2 c3 s0 q0 q1 q2 q3 q4 q5 q6

