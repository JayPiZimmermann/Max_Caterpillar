    Maximum 5 x = rhs x := by
  rw [max_eq x 1 (by linarith only [c2, c3]) (le_refl _) (by linarith only [c0, c1, c2, c3]) (by linarith only [c3]) (by linarith only [c1, c2, c3])]
  have q0 : relu (x 0 - x 3) = 0 :=
    relu_eq_zero (by linarith only [c2])
  have q1 : relu (x 0 - x 4) = x 0 - x 4 :=
    relu_eq_self (by linarith only [c1])
  have q2 : relu (x 2 - x 4) = 0 :=
