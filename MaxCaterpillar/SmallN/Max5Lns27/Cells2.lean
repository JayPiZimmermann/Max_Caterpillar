    relu_eq_self (by linarith only [c0])
  have q6 : relu (x 0 - x 1) = 0 :=
    relu_eq_zero (by linarith only [c1])
  rcases le_total 0 (x 0 + x 1 - x 2 - x 3) with s0 | s0
  · exact cell40_0 x c0 c1 c2 c3 s0 q0 q1 q2 q3 q4 q5 q6
  · exact cell40_1 x c0 c1 c2 c3 s0 q0 q1 q2 q3 q4 q5 q6

