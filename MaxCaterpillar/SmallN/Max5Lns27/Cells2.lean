    (c0 : x 2 ≤ x 0) (c1 : x 0 ≤ x 1) (c2 : x 1 ≤ x 3) (c3 : x 3 ≤ x 4) :
    Maximum 5 x = rhs x := by
  rw [max_eq x 4 (by linarith only [c1, c2, c3]) (by linarith only [c2, c3]) (by linarith only [c0, c1, c2, c3]) (by linarith only [c3]) (le_refl _)]
  have q0 : relu (x 0 - x 3) = 0 :=
