def auxTerms : List (ℚ × AuxTerm 5) :=
  [(3, .lin 0), (-1/2, .lin 1), (2, .lin 2), (-1/2, .lin 3), (-3, .lin 4), (-3/2, .pair 0 1), (1/2, .pair 0 2), (1/2, .pair 0 3), (-3/2, .pair 0 4), (-1, .pair 1 3), (1, .pair 1 4), (-1, .pair 2 4)]

theorem expansionEval_eq (x : Point 5) : expansionEval neurons auxTerms x = rhs x := by
  simp only [expansionEval, neurons, auxTerms, List.map_cons, List.map_nil, List.sum_cons,
    List.sum_nil, AuxTerm.eval, u0_eval, u1_eval, u2_eval, u3_eval, u4_eval, u5_eval, u6_eval, u7_eval, u8_eval, u9_eval, u10_eval, u11_eval, u12_eval, u13_eval, u14_eval, u15_eval, u16_eval, u17_eval, u18_eval, u19_eval, u20_eval, u21_eval, u22_eval, u23_eval, u24_eval, u25_eval, u26_eval]
  unfold rhs
  push_cast
  ring

/-- **Network.**  The paper's first hidden layer (`firstWidth 5` neurons) and
29 neurons in the second hidden layer (27 caterpillar functions and two for the
linear remainder); rational weights, zero biases. -/
theorem max_network :
    ∃ net : Network 5 (firstWidth 5) 29,
      (∀ x, net.eval x = Maximum 5 x) ∧ net.HasRationalWeights ∧ net.HasZeroBiases :=
  network_of_expansion (n := 4) neurons auxTerms
    (fun x => (identity x).trans (expansionEval_eq x).symm)

end MaxCaterpillar.SmallN.Max5Lns27
