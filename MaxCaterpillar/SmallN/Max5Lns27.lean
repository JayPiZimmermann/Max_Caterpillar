/-- **The identity, explicitly.** -/
theorem max_identity (x : Point 5) :
    Maximum 5 x =
      3/2 * relu (-x 0 - x 1 + x 3 + x 4 + relu (x 0 - x 3) + relu (x 0 - x 4) + relu (x 2 - x 4))
      - 2 * relu (-x 0 - x 1 + x 3 + x 4 + relu (x 1 - x 3) + relu (x 1 - x 4) + relu (x 2 - x 4))
      + 1/2 * relu (-x 0 - x 1 + x 3 + x 4 + relu (x 0 - x 2) + relu (x 0 - x 3))
      - 1/2 * relu (-x 0 - x 1 + x 3 + x 4 + relu (x 0 - x 2) + relu (x 0 - x 3) + relu (x 2 - x 4))
      + 3/2 * relu (-x 0 - x 1 + x 3 + x 4 + relu (x 1 - x 3) + relu (x 2 - x 4))
      + 1/2 * relu (-x 0 + x 3 + relu (x 2 - x 4))
      + 3/2 * relu (-x 0 + x 3 + relu (x 1 - x 3) + relu (x 2 - x 4))
      - 1/2 * relu (-x 0 + x 2 + x 3 - x 4 + relu (x 0 - x 2) + relu (x 0 - x 3) + relu (x 1 - x 3))
      + 3/2 * relu (-x 0 + x 2 + x 3 - x 4 + relu (x 0 - x 1) + relu (x 0 - x 2) + relu (x 1 - x 3))
      + 3/2 * relu (-x 0 + x 1 - x 2 + x 4 + relu (x 0 - x 1) + relu (x 0 - x 4))
      - 3/2 * relu (-x 0 + x 1 - x 2 + x 4 + relu (x 0 - x 1) + relu (x 0 - x 3) + relu (x 0 - x 4))
      + 3/2 * relu (-x 0 + x 1 - x 3 + x 4 + relu (x 0 - x 1) + relu (x 0 - x 4))
      - 3/2 * relu (-x 0 + x 1 - x 3 + x 4 + relu (x 0 - x 1) + relu (x 0 - x 2) + relu (x 0 - x 4))
      - 3/2 * relu (-x 0 + x 1 + x 2 - x 4 + relu (x 0 - x 2))
      + 1/2 * relu (-x 0 + x 1 + x 2 - x 4 + relu (x 0 - x 2) + relu (x 0 - x 3))
      - 1/2 * relu (-x 1 - x 2 + x 3 + x 4 + relu (x 0 - x 3) + relu (x 1 - x 3))
      + relu (-x 1 - x 2 + x 3 + x 4 + relu (x 0 - x 3) + relu (x 1 - x 3) + relu (x 1 - x 4))
      - 3/2 * relu (-x 1 + x 3 + relu (x 0 - x 3) + relu (x 2 - x 4))
      - 3/2 * relu (-x 1 + x 2 + x 3 - x 4 + relu (x 0 - x 2) + relu (x 1 - x 3))
      + relu (-x 3 + x 4 + relu (x 0 - x 2) + relu (x 1 - x 4) + relu (x 2 - x 4))
      + 3/2 * relu (x 1 - x 2 - x 3 + x 4 + relu (x 0 - x 1) + relu (x 0 - x 4))
      + 1/2 * relu (x 1 - x 3 + relu (x 0 - x 2))
      - 1/2 * relu (x 1 - x 3 + relu (x 0 - x 2) + relu (x 2 - x 4))
      + relu (x 0 - x 1 - x 2 + x 4 + relu (x 1 - x 3) + relu (x 1 - x 4))
      - 2 * relu (x 0 - x 2 - x 3 + x 4 + relu (x 1 - x 4))
      + relu (x 0 - x 2 - x 3 + x 4 + relu (x 1 - x 4) + relu (x 2 - x 4))
      - 3/2 * relu (x 0 - x 3 + relu (x 1 - x 4))
      + 3 * x 0
      - 1/2 * x 1
      + 2 * x 2
      - 1/2 * x 3
      - 3 * x 4
      - 3/2 * relu (x 0 - x 1)
      + 1/2 * relu (x 0 - x 2)
      + 1/2 * relu (x 0 - x 3)
      - 3/2 * relu (x 0 - x 4)
      - relu (x 1 - x 3)
      + relu (x 1 - x 4)
      - relu (x 2 - x 4) :=
  identity x

