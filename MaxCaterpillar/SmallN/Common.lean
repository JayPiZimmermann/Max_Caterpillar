import MaxCaterpillar.SmallArity

/-! # Shared infrastructure for generated small-arity expansions

The files in `MaxCaterpillar/SmallN/` are generated by
`scripts/smalln/gen_lean.py` from exact rational expansion data
(`scripts/smalln/README.md`).  Each instance proves an identity

  `Maximum N x = Σ_k d_k σ(h_k·x + Σ_{(i,j) ∈ M_k} σ(x_i - x_j)) + Σ_t a_t ℓ_t(x)`

on all of `ℝ^N` by a finite cover of closed polyhedral cones, and then the
corresponding two-hidden-layer network statement.

This module contains the instance-independent part:

* the data format `Neuron` / `AuxTerm` and its evaluation `expansionEval`;
  a neuron is `σ(Σ_i h_i x_i + Σ_t w_t σ(x_{a_t} - x_{b_t}))` with arbitrary
  rational `h` and `w`, i.e. an arbitrary rational second-hidden-layer neuron
  over the first-layer features `x_i` and `σ(x_i - x_j)`; caterpillar
  functions are the special case of integer heads and unit weights;
* `network_of_rows`: the explicit two-hidden-layer network for rows over a
  fixed rational first layer, with two extra neurons for the linear remainder;
* `network_of_expansion`: an identity `Maximum N = expansionEval U A` gives a
  network with the paper's first hidden layer (`firstWidth N` neurons:
  `σ(±x_0)`, `σ(x_i - x_0)`, `σ(x_i - x_j)`), `U.length + 2` neurons in the
  second hidden layer, rational weights and zero biases.
-/

open BigOperators

namespace MaxCaterpillar.SmallN

open MaxNN.Caterpillar.Corrections MaxNN.Width MaxNN.ParamidGeom MaxNN.ParamidChain

/-! ## Elementary facts used by every cell proof -/

theorem relu_eq_self {t : ℝ} (h : 0 ≤ t) : relu t = t := max_eq_right h

theorem relu_eq_zero {t : ℝ} (h : t ≤ 0) : relu t = 0 := max_eq_left h

theorem relu_sub_relu_neg_self (t : ℝ) : relu t - relu (-t) = t := by
  unfold relu
  rcases le_total 0 t with h | h
  · rw [max_eq_right h, max_eq_left (neg_nonpos.mpr h), sub_zero]
  · rw [max_eq_left h, max_eq_right (neg_nonneg.mpr h), zero_sub, neg_neg]

theorem maximum_eq_of_le {N : ℕ} [NeZero N] (x : Point N) (t : Fin N)
    (h : ∀ i, x i ≤ x t) : Maximum N x = x t :=
  le_antisymm (Finset.sup'_le _ _ fun i _ => h i) (Finset.le_sup' x (Finset.mem_univ t))

/-! ## Expansion data -/

/-- A second-hidden-layer neuron with output coefficient `coef`:
`coef · σ(Σ_i head_i x_i + Σ_{(w,a,b) ∈ hinges} w σ(x_a - x_b))`. -/
structure Neuron (N : ℕ) where
  coef : ℚ
  head : Fin N → ℚ
  hinges : List (ℚ × Fin N × Fin N)

/-- The preactivation `Σ_i head_i x_i + Σ w σ(x_a - x_b)`. -/
noncomputable def Neuron.arg {N : ℕ} (u : Neuron N) (x : Point N) : ℝ :=
  ∑ i, (u.head i : ℝ) * x i + (u.hinges.map fun h => (h.1 : ℝ) * relu (x h.2.1 - x h.2.2)).sum

/-- A term of the linear remainder: the coordinate `x_i` or `σ(x_i - x_j)`. -/
inductive AuxTerm (N : ℕ)
  | lin (i : Fin N)
  | pair (i j : Fin N)

noncomputable def AuxTerm.eval {N : ℕ} : AuxTerm N → Point N → ℝ
  | .lin i, x => x i
  | .pair i j, x => relu (x i - x j)

/-- `Σ_k d_k σ(arg_k(x)) + Σ_t a_t ℓ_t(x)` for neurons `U` and remainder `A`. -/
noncomputable def expansionEval {N : ℕ} (U : List (Neuron N)) (A : List (ℚ × AuxTerm N))
    (x : Point N) : ℝ :=
  (U.map fun u => (u.coef : ℝ) * relu (u.arg x)).sum + (A.map fun t => (t.1 : ℝ) * t.2.eval x).sum

/-! ## Linear forms in the features -/

section Lin

variable {h : ℕ}

/-- The linear form with coefficient vector `v`, evaluated at `y`. -/
def lf (v y : Fin h → ℝ) : ℝ := ∑ k, v k * y k

theorem lf_add (v w y : Fin h → ℝ) : lf (v + w) y = lf v y + lf w y := by
  unfold lf
  rw [← Finset.sum_add_distrib]
  exact Finset.sum_congr rfl fun k _ => add_mul _ _ _

theorem lf_smul (c : ℝ) (v y : Fin h → ℝ) : lf (c • v) y = c * lf v y := by
  unfold lf
  rw [Finset.mul_sum]
  exact Finset.sum_congr rfl fun k _ => by rw [Pi.smul_apply, smul_eq_mul, mul_assoc]

theorem lf_zero (y : Fin h → ℝ) : lf 0 y = 0 := by
  unfold lf
  exact Finset.sum_eq_zero fun k _ => by rw [Pi.zero_apply, zero_mul]

theorem lf_neg (v y : Fin h → ℝ) : lf (-v) y = -lf v y := by
  rw [← neg_one_smul ℝ v, lf_smul, neg_one_mul]

theorem lf_finset_sum {ι : Type*} (s : Finset ι) (v : ι → Fin h → ℝ) (y : Fin h → ℝ) :
    lf (∑ i in s, v i) y = ∑ i in s, lf (v i) y := by
  unfold lf
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [Finset.sum_apply, Finset.sum_mul]

theorem lf_list_sum {α : Type*} (L : List α) (v : α → Fin h → ℝ) (y : Fin h → ℝ) :
    lf (L.map v).sum y = (L.map fun a => lf (v a) y).sum := by
  induction L with
  | nil => simp only [List.map_nil, List.sum_nil, lf_zero]
  | cons a L ih => simp only [List.map_cons, List.sum_cons, lf_add, ih]

theorem ratVec_list_sum {α : Type*} (L : List α) (v : α → Fin h → ℝ)
    (hv : ∀ a ∈ L, RatVec (v a)) : RatVec (L.map v).sum := by
  induction L with
  | nil => exact ratVec_zero
  | cons a L ih =>
    rw [List.map_cons, List.sum_cons]
    exact (hv a (List.mem_cons_self _ _)).add (ih fun b hb => hv b (List.mem_cons_of_mem _ hb))

end Lin

/-! ## A two-hidden-layer network from explicit rows -/

section Rows

variable {N h₁ m : ℕ}

/-- First layer `W₁` (no bias), second-layer rows `rows k` followed by `R` and
`-R`, output weights `c k`, `1`, `-1`; all biases zero. -/
def rowsNet (W₁ : Fin h₁ → Fin N → ℝ) (rows : Fin m → Fin h₁ → ℝ) (c : Fin m → ℝ)
    (R : Fin h₁ → ℝ) : Network N h₁ (m + 2) :=
  ⟨W₁, 0, Fin.append rows ![R, -R], 0, Fin.append c ![1, -1], 0⟩

theorem rowsNet_eval (W₁ : Fin h₁ → Fin N → ℝ) (rows : Fin m → Fin h₁ → ℝ) (c : Fin m → ℝ)
    (R : Fin h₁ → ℝ) (x : Point N) :
    (rowsNet W₁ rows c R).eval x =
      ∑ k, c k * relu (lf (rows k) fun j => relu (∑ i, W₁ j i * x i)) +
        lf R fun j => relu (∑ i, W₁ j i * x i) := by
  unfold Network.eval rowsNet
  dsimp only
  rw [Fin.sum_univ_add, Fin.sum_univ_two]
  simp only [Fin.append_left, Fin.append_right, Pi.zero_apply, add_zero,
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
  have e : ∀ v : Fin h₁ → ℝ, (∑ j, v j * relu (∑ i, W₁ j i * x i)) =
      lf v fun j => relu (∑ i, W₁ j i * x i) := fun v => rfl
  simp only [e, lf_neg]
  have hr := relu_sub_relu_neg_self (lf R fun j => relu (∑ i, W₁ j i * x i))
  rw [one_mul, neg_one_mul, ← sub_eq_add_neg, hr]

theorem network_of_rows (W₁ : Fin h₁ → Fin N → ℝ) (hW : ∀ j i, W₁ j i ∈ ratField)
    (rows : Fin m → Fin h₁ → ℝ) (hrows : ∀ k, RatVec (rows k)) (c : Fin m → ℝ)
    (hc : ∀ k, c k ∈ ratField) (R : Fin h₁ → ℝ) (hR : RatVec R) (f : Point N → ℝ)
    (hf : ∀ x, f x = ∑ k, c k * relu (lf (rows k) fun j => relu (∑ i, W₁ j i * x i)) +
      lf R fun j => relu (∑ i, W₁ j i * x i)) :
    ∃ net : Network N h₁ (m + 2),
      (∀ x, net.eval x = f x) ∧ net.HasRationalWeights ∧ net.HasZeroBiases := by
  refine ⟨rowsNet W₁ rows c R, fun x => by rw [rowsNet_eval, hf], ?_, rfl, rfl, rfl⟩
  refine ⟨fun j i => mem_ratField_iff.mp (hW j i), fun k j => ?_, fun k => ?_⟩
  · refine mem_ratField_iff.mp ?_
    refine Fin.addCases (fun k => ?_) (fun k => ?_) k
    · show Fin.append rows ![R, -R] (Fin.castAdd 2 k) j ∈ ratField
      rw [Fin.append_left]
      exact hrows k j
    · show Fin.append rows ![R, -R] (Fin.natAdd m k) j ∈ ratField
      rw [Fin.append_right]
      fin_cases k
      · exact hR j
      · exact RatVec.neg hR j
  · refine mem_ratField_iff.mp ?_
    refine Fin.addCases (fun k => ?_) (fun k => ?_) k
    · show Fin.append c ![1, -1] (Fin.castAdd 2 k) ∈ ratField
      rw [Fin.append_left]
      exact hc k
    · show Fin.append c ![1, -1] (Fin.natAdd m k) ∈ ratField
      rw [Fin.append_right]
      fin_cases k
      · exact Subfield.one_mem _
      · exact Subfield.neg_mem _ (Subfield.one_mem _)

end Rows

/-! ## Rows over the paper's first hidden layer -/

section Compact

variable {n : ℕ}

/-- The first hidden layer of the paper: `σ(±x_0)`, `σ(x_i - x_0)`, `σ(x_i - x_j)`. -/
noncomputable def layerW₁ (n : ℕ) : Fin (compactWidth n) → Fin (n + 1) → ℝ :=
  (compactFeatureLayer n).A

theorem layerW₁_rat (j : Fin (compactWidth n)) (i : Fin (n + 1)) : layerW₁ n j i ∈ ratField :=
  ofCompact_W₁ ∅ 0 0 j i

theorem layer_feat (x : Point (n + 1)) :
    (fun j => relu (∑ i, layerW₁ n j i * x i)) = compactFeat n x := by
  have hb : (compactFeatureLayer n).b = 0 := (ofCompact_hasZeroBiases ∅ 0 0).1
  funext j
  show relu _ = MaxNN.relu ((compactFeatureLayer n).eval x j)
  unfold MaxNN.Affine.eval
  rw [hb]
  simp only [Pi.zero_apply, add_zero]
  rfl

/-- The row of a neuron over the first hidden layer. -/
noncomputable def Neuron.row (u : Neuron (n + 1)) : Fin (compactWidth n) → ℝ :=
  ∑ i, (u.head i : ℝ) • compactCoordCoeff i +
    (u.hinges.map fun h => (h.1 : ℝ) • compactHingeCoeff h.2.1 h.2.2).sum

theorem Neuron.lf_row (u : Neuron (n + 1)) (x : Point (n + 1)) :
    lf u.row (compactFeat n x) = u.arg x := by
  unfold Neuron.row Neuron.arg
  rw [lf_add, lf_finset_sum, lf_list_sum]
  congr 1
  · refine Finset.sum_congr rfl fun i _ => ?_
    rw [lf_smul]
    unfold lf
    rw [sum_compactCoordCoeff, compactCoordLin_feat]
  · congr 1
    refine List.map_congr fun _ _ => ?_
    rw [lf_smul]
    unfold lf
    rw [sum_compactHingeCoeff, compactHingeLin_feat]
    rfl

theorem Neuron.ratVec_row (u : Neuron (n + 1)) : RatVec u.row :=
  (ratVec_sum _ fun i _ => (ratVec_compactCoordCoeff i).smul (ratCast_mem_ratField _)).add
    (ratVec_list_sum _ _ fun _ _ => (ratVec_compactHingeCoeff _ _).smul (ratCast_mem_ratField _))

noncomputable def AuxTerm.row : AuxTerm (n + 1) → Fin (compactWidth n) → ℝ
  | .lin i => compactCoordCoeff i
  | .pair i j => compactHingeCoeff i j

theorem AuxTerm.lf_row (t : AuxTerm (n + 1)) (x : Point (n + 1)) :
    lf t.row (compactFeat n x) = t.eval x := by
  cases t with
  | lin i => unfold lf; rw [AuxTerm.row, sum_compactCoordCoeff, compactCoordLin_feat]; rfl
  | pair i j => unfold lf; rw [AuxTerm.row, sum_compactHingeCoeff, compactHingeLin_feat]; rfl

theorem AuxTerm.ratVec_row (t : AuxTerm (n + 1)) : RatVec t.row := by
  cases t with
  | lin i => exact ratVec_compactCoordCoeff i
  | pair i j => exact ratVec_compactHingeCoeff i j

end Compact

/-! ## Compilation -/

theorem list_sum_eq_fin_sum {α : Type*} (L : List α) (g : α → ℝ) :
    (L.map g).sum = ∑ k : Fin L.length, g (L.get k) := by
  conv_lhs => rw [← List.ofFn_get L]
  rw [List.map_ofFn, Fin.sum_ofFn]
  rfl

/-- **Generic small-arity compilation.**  An identity `max_N = expansionEval U A`
gives a network with the paper's first hidden layer (`firstWidth N`
neurons), `U.length + 2` neurons in the second hidden layer, rational weights
and zero biases. -/
theorem network_of_expansion {n : ℕ} (U : List (Neuron (n + 1)))
    (A : List (ℚ × AuxTerm (n + 1)))
    (hid : ∀ x, Maximum (n + 1) x = expansionEval U A x) :
    ∃ net : Network (n + 1) (firstWidth (n + 1)) (U.length + 2),
      (∀ x, net.eval x = Maximum (n + 1) x) ∧ net.HasRationalWeights ∧ net.HasZeroBiases := by
  obtain ⟨net, heval, hrat, hzero⟩ := network_of_rows (layerW₁ n) layerW₁_rat
    (fun k => (U.get k).row) (fun k => (U.get k).ratVec_row) (fun k => ((U.get k).coef : ℝ))
    (fun k => ratCast_mem_ratField _) ((A.map fun t => (t.1 : ℝ) • t.2.row).sum)
    (ratVec_list_sum _ _ fun t _ => t.2.ratVec_row.smul (ratCast_mem_ratField _))
    (Maximum (n + 1)) (fun x => by
      rw [layer_feat, hid x, expansionEval, list_sum_eq_fin_sum, lf_list_sum]
      congr 1
      · exact Finset.sum_congr rfl fun k _ => by rw [Neuron.lf_row]
      · congr 1
        refine List.map_congr fun t _ => ?_
        rw [lf_smul, AuxTerm.lf_row])
  have he := compactWidth_eq_firstWidth n
  refine ⟨he ▸ net, fun x => by rw [Network.cast_first_eval, heval], ?_, ?_⟩
  · exact (Network.cast_first_props he net).1 hrat
  · exact (Network.cast_first_props he net).2 hzero

end MaxCaterpillar.SmallN
