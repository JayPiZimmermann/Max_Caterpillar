private theorem table3_data :
    ((Finset.univ : Finset (Fin 12)).powersetCard 3).val =
      (table3.map Entry.frame : List (Finset (Fin 12))) := by rfl

private theorem table3_covers {S : Finset (Fin 12)}
    (h : S ∈ (Finset.univ : Finset (Fin 12)).powersetCard 3) :
    S ∈ table3.map Entry.frame := by
  change S ∈ ((Finset.univ : Finset (Fin 12)).powersetCard 3).val at h
  rw [table3_data] at h
  exact h

private lemma decoded_encoding (F : Frame) (hloop : NoLoops F) :
    ∃ S : Finset (Fin 12), decoded S = F ∧ S.card = F.card := by
  let S : Finset (Fin 12) := Finset.univ.filter fun i => rootPair i ∈ F
  have hd : decoded S = F := by
    apply Finset.ext
    intro r
    constructor
    · intro hr
      obtain ⟨i, hi, he⟩ := Finset.mem_image.mp hr
      have hm := (Finset.mem_filter.mp hi).2
      rwa [he] at hm
    · intro hr
      obtain ⟨i, hi⟩ := rootPair_enumerated r (hloop r hr)
      exact Finset.mem_image.mpr
        ⟨i, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi.symm ▸ hr⟩, hi⟩
  have hc : (decoded S).card = S.card := Finset.card_image_of_injective S rootPair_injective
  exact ⟨S, hd, hc.symm.trans (congrArg Finset.card hd)⟩

/-- Every pair of distinct oriented coordinate roots has one of the five
canonical geometries, up to an actual input-label permutation. -/
theorem two_roots_cases (F : Frame) (hcard : F.card = 2) (hloop : NoLoops F) :
    ∃ p : Fin 4 → Fin 4, Function.Injective p ∧
      ∃ k : Fin 5, F = relabel p (twoCanonical k) := by
  obtain ⟨S, hd, hc⟩ := decoded_encoding F hloop
  have hm : S ∈ (Finset.univ : Finset (Fin 12)).powersetCard 2 :=
    Finset.mem_powersetCard.mpr ⟨Finset.subset_univ S, hc.trans hcard⟩
  have ht := table2_covers hm
  rw [List.mem_map] at ht
  obtain ⟨e, he, hs⟩ := ht
  obtain ⟨hi, hf⟩ := table2_checked e he
  refine ⟨e.perm, hi, e.kind, ?_⟩
  rw [hs, hd] at hf
  exact hf

/-- Every triple of distinct oriented roots is a triangle, an opposite pair
with a third edge, a path, or a star, with all directions accounted for. -/
theorem three_roots_cases (F : Frame) (hcard : F.card = 3) (hloop : NoLoops F) :
    ∃ p : Fin 4 → Fin 4, Function.Injective p ∧
      ∃ k : Fin 21, F = relabel p (threeCanonical k) := by
  obtain ⟨S, hd, hc⟩ := decoded_encoding F hloop
  have hm : S ∈ (Finset.univ : Finset (Fin 12)).powersetCard 3 :=
    Finset.mem_powersetCard.mpr ⟨Finset.subset_univ S, hc.trans hcard⟩
  have ht := table3_covers hm
  rw [List.mem_map] at ht
  obtain ⟨e, he, hs⟩ := ht
  obtain ⟨hi, hf⟩ := table3_checked e he
  refine ⟨e.perm, hi, e.kind, ?_⟩
  rw [hs, hd] at hf
  exact hf

/-- The finite relabeling witnesses are genuine input permutations. -/
theorem two_roots_permutation (F : Frame) (hcard : F.card = 2) (hloop : NoLoops F) :
    ∃ p : Equiv.Perm (Fin 4), ∃ k : Fin 5, F = relabel p (twoCanonical k) := by
  obtain ⟨p, hp, k, hk⟩ := two_roots_cases F hcard hloop
  exact ⟨Equiv.ofBijective p ⟨hp, Finite.surjective_of_injective hp⟩, k, hk⟩

theorem three_roots_permutation (F : Frame) (hcard : F.card = 3) (hloop : NoLoops F) :
    ∃ p : Equiv.Perm (Fin 4), ∃ k : Fin 21, F = relabel p (threeCanonical k) := by
  obtain ⟨p, hp, k, hk⟩ := three_roots_cases F hcard hloop
  exact ⟨Equiv.ofBijective p ⟨hp, Finite.surjective_of_injective hp⟩, k, hk⟩

#check @two_roots_cases
#check @three_roots_cases
#print axioms two_roots_cases
#print axioms three_roots_cases
#print axioms two_roots_permutation
#print axioms three_roots_permutation
