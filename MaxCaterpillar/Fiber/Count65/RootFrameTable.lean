/-- Raw enumeration equality avoids a quadratic table membership search. -/
private theorem table_data :
    ((Finset.univ : Finset (Fin 12)).powersetCard 4).val =
      (table.map Prod.fst : List (Finset (Fin 12))) := by rfl



/-- Exhaustive integer certificate or geometric normal form. -/
theorem four_roots_checked_alternative (F : Frame) (hcard : F.card = 4)
    (hloop : NoLoops F) (hcover : CoversTriples F) :
    (∃ w : Witness, w.Checked F) ∨ NormalForm F := by
  let S : Finset (Fin 12) := Finset.univ.filter fun i => rootPair i ∈ F
  have hd : decoded S = F := by
    apply Finset.ext
    intro p
    constructor
    · intro hp
      obtain ⟨i, hi, he⟩ := Finset.mem_image.mp hp
      have hm := (Finset.mem_filter.mp hi).2
      rwa [he] at hm
    · intro hp
      obtain ⟨i, hi⟩ := rootPair_enumerated p (hloop p hp)
      apply Finset.mem_image.mpr
      exact ⟨i, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi.symm ▸ hp⟩, hi⟩
  have hc : S.card = 4 := by
    have he : (decoded S).card = S.card := Finset.card_image_of_injective S rootPair_injective
    rw [hd, hcard] at he
    exact he.symm
  have hm : S ∈ (Finset.univ : Finset (Fin 12)).powersetCard 4 :=
    Finset.mem_powersetCard.mpr ⟨Finset.subset_univ S, hc⟩
  have hcov : CoversTriples (decoded S) := hd.symm ▸ hcover
  have hentry : S ∈ table.map Prod.fst := by
    change S ∈ ((Finset.univ : Finset (Fin 12)).powersetCard 4).val at hm
    rw [table_data] at hm
    exact hm
  obtain ⟨entry, hmem, he⟩ := List.mem_map.mp hentry
  have hv := (List.forall_iff_forall_mem.mp table_checked) entry hmem
  rw [he] at hv
  have hn : (∃ w : Witness, w.Checked (decoded S)) ∨ NormalForm (decoded S) := by
    cases hec : entry.2 with
    | bad w =>
      rw [hec] at hv
      exact Or.inl ⟨w, hv⟩
    | good p star =>
      rw [hec] at hv
      obtain ⟨hp, heq⟩ := hv
      refine Or.inr ⟨p, hp, ?_⟩
      cases star
      · exact Or.inl heq
      · exact Or.inr heq
    | irrelevant =>
      rw [hec] at hv
      exact False.elim (hv hcov)
  exact hd ▸ hn

#check @four_roots_checked_alternative
#print axioms four_roots_checked_alternative
end MaxCaterpillar.Fiber.Count65.RootFrames
