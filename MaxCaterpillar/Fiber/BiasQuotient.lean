import MaxCaterpillar.Fiber.Bias
import MaxCaterpillar.Fiber.Symmetry
import MaxCaterpillar.Fiber.QuotientRetraction
import Mathlib.Data.Setoid.Basic

/-! # Bias removal after the genuine symmetry quotient

Bias removal commutes with each allowed neuron scaling and permutation. Therefore
the strong deformation retraction gives a bijection of connected components also
after quotienting these symmetries. No path lifting in the symmetry quotient is
assumed.
-/

set_option autoImplicit false

namespace MaxCaterpillar.Fiber

variable {N h₁ h₂ : ℕ} [NeZero N]

theorem zeroBiasFiber_scaleFirst (net : ExactFiber N h₁ h₂)
    (s : Fin h₁ → ℝ) (hs : ∀ j, 0 < s j) :
    zeroBiasFiber (scaleFirstFiber s hs net) = scaleFirstFiber s hs (zeroBiasFiber net) := by
  apply Subtype.ext
  change (scaleFirst net.val s).zeroBias = scaleFirst net.val.zeroBias s
  simpa only [scaleBias_zero] using scaleBias_scaleFirst net.val s 0

theorem zeroBiasFiber_scaleSecond (net : ExactFiber N h₁ h₂)
    (s : Fin h₂ → ℝ) (hs : ∀ k, 0 < s k) :
    zeroBiasFiber (scaleSecondFiber s hs net) = scaleSecondFiber s hs (zeroBiasFiber net) := by
  apply Subtype.ext
  change (scaleSecond net.val s).zeroBias = scaleSecond net.val.zeroBias s
  simpa only [scaleBias_zero] using scaleBias_scaleSecond net.val s 0

theorem zeroBiasFiber_permuteHidden (net : ExactFiber N h₁ h₂)
    (p : Equiv.Perm (Fin h₁)) (q : Equiv.Perm (Fin h₂)) :
    zeroBiasFiber (permuteHiddenFiber p q net) = permuteHiddenFiber p q (zeroBiasFiber net) := by
  apply Subtype.ext
  change (permuteHidden net.val p q).zeroBias = permuteHidden net.val.zeroBias p q
  simpa only [scaleBias_zero] using scaleBias_permuteHidden net.val p q 0

theorem zeroBiasFiber_permuteInputs (net : ExactFiber N h₁ h₂)
    (p : Equiv.Perm (Fin N)) :
    zeroBiasFiber (permuteInputsFiber p net) = permuteInputsFiber p (zeroBiasFiber net) := by
  apply Subtype.ext
  change (permuteInputs net.val p).zeroBias = permuteInputs net.val.zeroBias p
  simpa only [scaleBias_zero] using scaleBias_permuteInputs net.val p 0

/-- Every allowed symmetry step is respected by zero-bias reduction. -/
theorem zeroBiasFiber_symmetryStep {net net' : ExactFiber N h₁ h₂}
    (h : SymmetryStep net net') : SymmetryStep (zeroBiasFiber net) (zeroBiasFiber net') := by
  cases h with
  | first s hs =>
      rw [zeroBiasFiber_scaleFirst]
      exact SymmetryStep.first _ s hs
  | second s hs =>
      rw [zeroBiasFiber_scaleSecond]
      exact SymmetryStep.second _ s hs
  | hidden p q =>
      rw [zeroBiasFiber_permuteHidden]
      exact SymmetryStep.hidden _ p q
  | input p =>
      rw [zeroBiasFiber_permuteInputs]
      exact SymmetryStep.input _ p

/-- The full equivalence generated by allowed symmetries is respected as well. -/
theorem zeroBiasFiber_symmetry {net net' : ExactFiber N h₁ h₂}
    (h : (symmetrySetoid N h₁ h₂).r net net') :
    (symmetrySetoid N h₁ h₂).r (zeroBiasFiber net) (zeroBiasFiber net') := by
  change EqvGen SymmetryStep net net' at h
  change EqvGen SymmetryStep (zeroBiasFiber net) (zeroBiasFiber net')
  induction h with
  | rel a b hab => exact EqvGen.rel _ _ (zeroBiasFiber_symmetryStep hab)
  | refl a => exact EqvGen.refl _
  | symm a b hab ih => exact EqvGen.symm _ _ ih
  | trans a b c hab hbc ihab ihbc => exact EqvGen.trans _ _ _ ihab ihbc

/-- The genuine network symmetry relation restricted to zero-bias networks. -/
def zeroBiasSymmetrySetoid (N h₁ h₂ : ℕ) [NeZero N] : Setoid (ZeroBiasFiber N h₁ h₂) :=
  Setoid.comap includeZeroBias (symmetrySetoid N h₁ h₂)

/-- The zero-bias exact fiber with the same neuron and input symmetries identified. -/
abbrev ZeroBiasSymmetryQuotient (N h₁ h₂ : ℕ) [NeZero N] :=
  Quotient (zeroBiasSymmetrySetoid N h₁ h₂)

/-- Allowing biases does not alter the component count, even after all stated symmetries. -/
noncomputable def zeroBiasQuotientConnectedComponentsEquiv :
    ConnectedComponents (SymmetryQuotient N h₁ h₂) ≃
      ConnectedComponents (ZeroBiasSymmetryQuotient N h₁ h₂) :=
  connectedComponentsEquivOfQuotientRetraction
    (symmetrySetoid N h₁ h₂) (zeroBiasSymmetrySetoid N h₁ h₂)
    zeroBiasRetraction includeZeroBias
    continuous_zeroBiasRetraction continuous_includeZeroBias
    (fun _ _ h => zeroBiasFiber_symmetry h) (fun _ _ h => h)
    zeroBiasRetraction_include (fun net => ⟨biasPath net⟩)

/-- A zero-bias classification transfers exactly to the arbitrary-bias component count. -/
theorem hasComponentCount_iff_zeroBias (count : ℕ) :
    HasComponentCount N h₁ h₂ count ↔
      Nonempty (ConnectedComponents (ZeroBiasSymmetryQuotient N h₁ h₂) ≃ Fin count) := by
  constructor
  · rintro ⟨e⟩
    exact ⟨zeroBiasQuotientConnectedComponentsEquiv.symm.trans e⟩
  · rintro ⟨e⟩
    exact ⟨zeroBiasQuotientConnectedComponentsEquiv.trans e⟩

end MaxCaterpillar.Fiber
