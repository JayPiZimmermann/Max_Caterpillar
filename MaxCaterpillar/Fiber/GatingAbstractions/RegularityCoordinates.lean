import MaxCaterpillar.Definitions
import Mathlib

/-! Fixed coordinates for the full bias-free physical (6,3) network space.
Generated by research/sN/zulip_three/jacobian_emit.py; do not edit generated data.
The zero-bias model is bridged to the existing six-array Network, not redefined.
-/
set_option autoImplicit false
set_option maxRecDepth 4096
namespace MaxCaterpillar.Fiber.GatingAbstractions
open BigOperators
abbrev Raw := Fin 45 → ℝ
abbrev Free := Fin 17 → ℝ

noncomputable def fromRaw (p : Raw) : Network 4 6 3 :=
  { W₁ := ![![p 0, p 1, p 2, p 3], ![p 4, p 5, p 6, p 7], ![p 8, p 9, p 10, p 11], ![p 12, p 13, p 14, p 15], ![p 16, p 17, p 18, p 19], ![p 20, p 21, p 22, p 23]]
    b₁ := 0
    W₂ := ![![p 24, p 25, p 26, p 27, p 28, p 29], ![p 30, p 31, p 32, p 33, p 34, p 35], ![p 36, p 37, p 38, p 39, p 40, p 41]]
    b₂ := 0
    w₃ := ![p 42, p 43, p 44]
    b₃ := 0 }

noncomputable def toRaw (net : Network 4 6 3) : Raw :=
  ![net.W₁ 0 0, net.W₁ 0 1, net.W₁ 0 2, net.W₁ 0 3, net.W₁ 1 0, net.W₁ 1 1, net.W₁ 1 2, net.W₁ 1 3, net.W₁ 2 0, net.W₁ 2 1, net.W₁ 2 2, net.W₁ 2 3, net.W₁ 3 0, net.W₁ 3 1, net.W₁ 3 2, net.W₁ 3 3, net.W₁ 4 0, net.W₁ 4 1, net.W₁ 4 2, net.W₁ 4 3, net.W₁ 5 0, net.W₁ 5 1, net.W₁ 5 2, net.W₁ 5 3, net.W₂ 0 0, net.W₂ 0 1, net.W₂ 0 2, net.W₂ 0 3, net.W₂ 0 4, net.W₂ 0 5, net.W₂ 1 0, net.W₂ 1 1, net.W₂ 1 2, net.W₂ 1 3, net.W₂ 1 4, net.W₂ 1 5, net.W₂ 2 0, net.W₂ 2 1, net.W₂ 2 2, net.W₂ 2 3, net.W₂ 2 4, net.W₂ 2 5, net.w₃ 0, net.w₃ 1, net.w₃ 2]

def freeIndices : Fin 17 → Fin 45 := ![0, 6, 9, 11, 17, 19, 13, 23, 42, 43, 44, 30, 31, 32, 33, 34, 35]
noncomputable def freeCoordinates (p : Raw) : Free := fun i => p (freeIndices i)

@[simp] theorem toRaw_fromRaw (p : Raw) : toRaw (fromRaw p) = p := by
  funext i
  fin_cases i <;> rfl

@[simp] theorem fromRaw_zeroBiases (p : Raw) : (fromRaw p).HasZeroBiases :=
  ⟨rfl, rfl, rfl⟩

theorem fromRaw_toRaw (net : Network 4 6 3) (hz : net.HasZeroBiases) :
    fromRaw (toRaw net) = net := by
  rcases net with ⟨a,b,w,e,d,f⟩
  rcases hz with ⟨hb,he,hf⟩
  dsimp only at hb he hf
  subst b
  subst e
  subst f
  dsimp only [fromRaw, toRaw]
  congr 1
  · funext i j
    fin_cases i <;> fin_cases j <;> rfl
  · funext i j
    fin_cases i <;> fin_cases j <;> rfl
  · funext i
    fin_cases i <;> rfl

end MaxCaterpillar.Fiber.GatingAbstractions
