\makeatletter
\newcommand{\DeclareLeanEquation}[3]{%
  \expandafter\def\csname paper@lean@#1\endcsname{\leanbase/#2\#L#3}%
}
\newcommand{\LeanLinkIfDeclared}[2]{%
  \ifcsname paper@lean@#1\endcsname
    \href{\csname paper@lean@#1\endcsname}{#2}%
  \else
    #2%
  \fi
}
\AtBeginDocument{%
\newif\ifpaper@displaytag
\let\paper@equationlabel\@empty
\let\paper@original@labeldisplay\label@in@display
\def\label@in@display{%
  \@ifnextchar[\paper@labeldisplay@opt\paper@labeldisplay@plain
}
\def\paper@labeldisplay@plain#1{%
  \gdef\paper@equationlabel{#1}%
  \paper@original@labeldisplay{#1}%
}
\def\paper@labeldisplay@opt[#1]#2{%
  \gdef\paper@equationlabel{#2}%
  \paper@original@labeldisplay[#1]{#2}%
}
\let\paper@original@makedisplaytag\make@display@tag
\def\make@display@tag{%
  \paper@displaytagtrue
  \paper@original@makedisplaytag
  \paper@displaytagfalse
  \ifmeasuring@\else\global\let\paper@equationlabel\@empty\fi
}
\let\paper@original@tagform\tagform@
\def\tagform@#1{%
  \ifpaper@displaytag
    \ifmeasuring@
      \paper@original@tagform{#1}%
    \else
      \ifcsname paper@lean@\paper@equationlabel\endcsname
        \href{\csname paper@lean@\paper@equationlabel\endcsname}%
          {\paper@original@tagform{#1}}%
      \else
        \PackageWarning{lean_equation_links}%
          {No Lean equation mapping for `\paper@equationlabel'}%
        \paper@original@tagform{#1}%
      \fi
    \fi
  \else
    \paper@original@tagform{#1}%
  \fi
}
}
\makeatother
