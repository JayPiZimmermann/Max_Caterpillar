import MaxCaterpillar.Fiber.Count65.AtLeast65

set_option autoImplicit false
noncomputable section
open MaxCaterpillar MaxCaterpillar.Fiber MaxCaterpillar.Fiber.Count65

/-- The quotient relation is exactly the equivalence generated by the actual
positive scaling and hidden/input permutation operations. -/
example (a b : ExactFiber 4 6 5) :
    (symmetrySetoid 4 6 5).r a b ↔ EqvGen SymmetryStep a b := Iff.rfl

example : Continuous (globalLabel :
    Quotient (zeroBiasSymmetrySetoid 4 6 5) → Unit ⊕ (NonpairedLabel ⊕ NonpairedLabel)) :=
  continuous_globalLabel
example : Function.Surjective (globalLabel :
    Quotient (zeroBiasSymmetrySetoid 4 6 5) → Unit ⊕ (NonpairedLabel ⊕ NonpairedLabel)) :=
  globalLabel_surjective
example : Continuous (globalLabelFin65 : Quotient (zeroBiasSymmetrySetoid 4 6 5) → Fin 65) :=
  continuous_globalLabelFin65
example : Function.Surjective (globalLabelFin65 : Quotient (zeroBiasSymmetrySetoid 4 6 5) → Fin 65) :=
  globalLabelFin65_surjective

/-- Literal injections record 65 distinct components without assuming the
component space finite. Natural cardinality is not used for infinite spaces. -/
example : Fin 65 ↪ ConnectedComponents (Quotient (zeroBiasSymmetrySetoid 4 6 5)) :=
  zeroBiasComponentsEmbedding65
example : Fin 65 ↪ ConnectedComponents (Quotient (symmetrySetoid 4 6 5)) :=
  fullComponentsEmbedding65
example : Nonempty (Fin 65 ↪ ConnectedComponents (Quotient (symmetrySetoid 4 6 5))) :=
  max4_6_5_at_least_65_components
example : (65 : Cardinal) ≤ Cardinal.mk (ConnectedComponents (Quotient (symmetrySetoid 4 6 5))) :=
  max4_6_5_component_cardinal_lower

