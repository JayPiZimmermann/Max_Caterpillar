Mixed65.physical_coefficient_bound : ∀ (net : Network 4 6 5) (t : ℝ),
  0 < t →
    net.W₁ = Mixed65.firstRows t →
      (∀ (x : Point 4), Network.eval net x = Maximum 4 x) → 1 ≤ t * Mixed65.coefficientSize net
Mixed65.physical_three_gate_extraction : ∀ (net : Network 4 6 5) (t : ℝ),
  0 < t →
    net.W₁ = Mixed65.firstRows t →
      (∀ (y : Point 4), Network.eval net y = Maximum 4 y) →
        ∃ S,
          Finset.card S = 3 ∧
            ∃ l,
              ∀ (x : Mixed65.InvariantState),
                Mixed65.invariantTarget x =
                  (Finset.sum Finset.univ fun j => l j * Mixed65.physicalInvariantPart net t j x) +
                    Finset.sum S fun j => Network.w₃ net j * relu (Mixed65.physicalInvariantPart net t j x)
