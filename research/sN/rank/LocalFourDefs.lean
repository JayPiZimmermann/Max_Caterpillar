/-! Finite certificate for the local sparsity at 4-localities (research/sN/rank).
Kernel-checked by `decide`; no Mathlib. Generated by gen_lean4.py from cert4.json. -/
namespace LocalFour

def relu (x : Int) : Int := if 0 < x then x else 0

/-- germ `(v, M)`: `z ↦ relu(⟨v,z⟩ + Σ_{(p,c)∈M} relu(z_p - z_c))`. -/
def germEval (v : List Int) (M : List (Nat × Nat)) (z : List Int) : Int :=
  relu ((List.zipWith (· * ·) v z).foldl (· + ·) 0 +
    (M.map fun e => relu (z.getD e.1 0 - z.getD e.2 0)).foldl (· + ·) 0)

def maxEval (z : List Int) : Int := z.foldl max (z.headD 0)

/-- the 16 corners `base + Σ_{i∈S} steps_i e_i` with sign `(-1)^(4-|S|)`. -/
def corners (b c : List Int) : List (Int × List Int) :=
  (List.range 16).map fun S =>
    let bits := (List.range 4).map fun i => (S / 2 ^ i) % 2
    let card := bits.foldl (· + ·) 0
    (if card % 2 = 0 then 1 else -1,
     (List.range 4).map fun i => b.getD i 0 + (if bits.getD i 0 = 1 then c.getD i 0 else 0))

def mixed (b c : List Int) (f : List Int → Int) : Int :=
  ((corners b c).map fun p => p.1 * f p.2).foldl (· + ·) 0

def stencils : List (List Int × List Int) :=
  [([0, (-1 : Int), 0, 0], [1, 3, 1, 1]),
   ([0, 0, (-2 : Int), (-1 : Int)], [1, 1, 3, 2]),
   ([0, 1, 1, 1], [3, 1, 1, 1]),
   ([0, (-1 : Int), 0, (-1 : Int)], [1, 2, 1, 2]),
   ([0, 1, 1, 0], [2, 1, 1, 2]),
   ([0, 0, (-1 : Int), 0], [1, 1, 3, 1]),
   ([0, 0, 0, (-1 : Int)], [1, 1, 1, 3]),
   ([0, (-2 : Int), 0, 0], [1, 3, 3, 1]),
   ([0, (-2 : Int), 0, 0], [1, 3, 1, 3]),
   ([0, 2, 1, 2], [3, 1, 2, 1]),
   ([0, 0, (-2 : Int), 0], [3, 1, 3, 1]),
   ([0, 0, 0, (-2 : Int)], [1, 1, 3, 3]),
   ([0, 0, 0, (-2 : Int)], [2, 1, 1, 3]),
   ([0, (-1 : Int), (-2 : Int), 0], [1, 3, 3, 1]),
   ([0, (-1 : Int), 1, 1], [2, 3, 1, 1]),
   ([0, 0, (-2 : Int), 0], [1, 1, 3, 2]),
   ([0, 0, 0, (-2 : Int)], [1, 2, 1, 3]),
   ([0, 2, 2, 2], [3, 1, 1, 3]),
   ([0, 2, 2, 2], [3, 3, 1, 1]),
   ([0, 2, 2, 2], [3, 1, 3, 1]),
   ([0, (-1 : Int), 0, 0], [1, 2, 1, 1]),
   ([0, (-2 : Int), (-1 : Int), 0], [2, 3, 2, 1]),
   ([0, 1, (-1 : Int), 1], [3, 2, 3, 2]),
   ([0, (-2 : Int), (-1 : Int), 0], [1, 3, 2, 1]),
   ([0, (-2 : Int), 0, (-2 : Int)], [2, 3, 3, 3])]

/-- structural superset: apex `a` with `v_a = -1` and no hinge at `a`; on the other
three coordinates `v_t ∈ [-1,3]`, `Σ v = 0`; hinges: at most two distinct unordered
pairs of `R`, each oriented either way. -/
def vrange : List Int := [-1, 0, 1, 2, 3]

def germs : List (List Int × List (Nat × Nat)) :=
  (List.range 4).bind fun a =>
    let R := (List.range 4).filter (· ≠ a)
    let r0 := R.getD 0 0; let r1 := R.getD 1 0; let r2 := R.getD 2 0
    let und : List (Nat × Nat) := [(r0, r1), (r0, r2), (r1, r2)]
    let orient (e : Nat × Nat) : List (Nat × Nat) := [e, (e.2, e.1)]
    let Ms : List (List (Nat × Nat)) :=
      [[]] ++ (und.bind fun e => (orient e).map fun x => [x]) ++
      ([(0, 1), (0, 2), (1, 2)].bind fun ij =>
        (orient (und.getD ij.1 (0, 0))).bind fun x =>
          (orient (und.getD ij.2 (0, 0))).map fun y => [x, y])
    vrange.bind fun x0 => vrange.bind fun x1 =>
      let x2 := 1 - x0 - x1
      if -1 ≤ x2 ∧ x2 ≤ 3 then
        let v := (List.range 4).map fun t =>
          if t = a then -1 else if t = r0 then x0 else if t = r1 then x1 else x2
        Ms.map fun M => (v, M)
      else []

def killMask (g : List Int × List (Nat × Nat)) : Nat :=
  ((stencils.enum).map fun (i, s) =>
    if mixed s.1 s.2 (germEval g.1 g.2) = 0 then 2 ^ i else 0).foldl (· + ·) 0

end LocalFour
