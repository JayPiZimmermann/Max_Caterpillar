MaxCaterpillar.caterpillar_count_exponential : ∀ (r : ℕ),
  ∀ K ⊆ MaxNN.Caterpillar.Corrections.normalizedKeys r,
    ∀ (d : MaxNN.Caterpillar.Corrections.RealKey (r + 1) → ℝ) (a : Fin (MaxNN.Width.W (r + 1 + 1)) → ℝ),
      (∀ (x : MaxCaterpillar.Point (r + 1 + 1)),
          MaxCaterpillar.Maximum (r + 1 + 1) x =
            (Finset.sum K fun k => d k * MaxNN.Caterpillar.Corrections.realUnitY k x) + MaxCaterpillar.auxiliary a x) →
        ∀ {k : ℕ}, 3 ≤ k → k ≤ r + 1 + 1 → Nat.choose (r + 1 + 1) k ≤ 6 ^ k * Finset.card K
MaxCaterpillar.caterpillar_count_exponential_pow : ∀ (r : ℕ),
  1 ≤ r →
    ∀ K ⊆ MaxNN.Caterpillar.Corrections.normalizedKeys r,
      ∀ (d : MaxNN.Caterpillar.Corrections.RealKey (r + 1) → ℝ) (a : Fin (MaxNN.Width.W (r + 1 + 1)) → ℝ),
        (∀ (x : MaxCaterpillar.Point (r + 1 + 1)),
            MaxCaterpillar.Maximum (r + 1 + 1) x =
              (Finset.sum K fun k => d k * MaxNN.Caterpillar.Corrections.realUnitY k x) +
                MaxCaterpillar.auxiliary a x) →
          7 ^ (r + 1 + 1) ≤ (r + 1 + 1 + 1) * 6 ^ (r + 1 + 1) * Finset.card K
