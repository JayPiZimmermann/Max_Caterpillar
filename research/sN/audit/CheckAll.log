@bhrsy_support_eq : ∀ {r : ℕ} {v : Fin (r + 1 + 1)} (π : BHRSY.Ordering (r + 1 + 1) v) {M : Finset ℕ},
  M ⊆ Finset.Icc 2 (r + 1) →
    ∀ (y : Point (r + 1 + 1)),
      BHRSY.paramidSupport v π M y =
        y v +
          MaxCaterpillar.relu
            (y (BHRSY.Ordering.pos π (BHRSY.lastMarked M)) - y v +
              ∑ i in Finset.Icc 2 (r + 1),
                MaxCaterpillar.relu (y (BHRSY.Ordering.pos π (BHRSY.markedParent M i)) - y (BHRSY.Ordering.pos π i)))
