  M ⊆ Finset.Icc 2 (r + 1) →
    ∀ (hne : Finset.Nonempty M),
      BHRSY.parallelepiped v π M =
        zonotope (Pi.single (BHRSY.Ordering.pos π (Finset.max' M hne)) 1) (Finset.Icc 2 (r + 1)) fun (i : ℕ) =>
          Pi.single (BHRSY.Ordering.pos π (BHRSY.markedParent M i)) 1 - Pi.single (BHRSY.Ordering.pos π i) 1
