@contrastBounded_periodic_eq_zero : ∀ {ι : Type u_1} (f : (ι → ℝ) → ℝ),
  ContrastBounded f → ∀ (v : ι → ℝ), (∃ i j, v i ≠ v j) → (∀ (x : ι → ℝ), f (x + v) = f x) → f = 0
@iterDiff_eq_zero_iff_of_contrastBounded : ∀ {ι : Type u_1} (f : (ι → ℝ) → ℝ),
  ContrastBounded f → ∀ (vs : List (ι → ℝ)), (∀ v ∈ vs, ∃ i j, v i ≠ v j) → (iterDiff vs f = 0 ↔ f = 0)
@maxCoordinateDifference_eq_tent : ∀ {N : ℕ} [inst : NeZero N] (x : Point N),
  maxCoordinateDifference x = (-1) ^ (N - 1) * max 0 (1 - Maximum N x - Maximum N (-x))
@iterDiff_maximum_ne_zero : ∀ {N : ℕ} [inst : NeZero N] (vs : List (Point N)),
  (∀ v ∈ vs, ∃ i j, v i ≠ v j) → iterDiff vs (Maximum N) ≠ 0
@maximum_ne_affine_sum_of_exists_periods : ∀ {N : ℕ} [inst : NeZero N] {J : Type u_1} [inst_1 : Fintype J],
  2 ≤ N →
    ∀ (f : J → Point N → ℝ),
      (∀ (k : J), ∃ v, (∃ i j, v i ≠ v j) ∧ ∀ (x : Point N), f k (x + v) = f k x) →
        ∀ (a : Point N →+ ℝ) (c : ℝ), ¬∀ (x : Point N), Maximum N x = a x + c + ∑ k : J, f k x
