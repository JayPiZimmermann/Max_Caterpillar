@exists_original_second_highrank : ∀ {N h₁ h₂ : ℕ} [inst : NeZero N],
  3 ≤ N →
    ∀ (net : AffineSkipNetwork N h₁ h₂),
      (∀ (x : Point N), eval net x = Maximum N x) →
        ∃ k, N - 1 ≤ FiniteDimensional.finrank ℝ ↥(LinearMap.range (secondObservation net k))
@exists_active_original_second_highrank : ∀ {N h₁ h₂ : ℕ} [inst : NeZero N],
  3 ≤ N →
    ∀ (net : AffineSkipNetwork N h₁ h₂),
      (∀ (x : Point N), eval net x = Maximum N x) →
        ∃ k,
          AffineSkipNetwork.d net k ≠ 0 ∧
            N - 1 ≤ FiniteDimensional.finrank ℝ ↥(LinearMap.range (secondObservation net k))
