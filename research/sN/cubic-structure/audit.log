@kappa_wordFaceKey : ∀ {r : ℕ} (w : MaxNN.Caterpillar.Corrections.WordIndex r)
  (τ : { x // x ∈ MaxNN.Caterpillar.Corrections.wordLabels w } → Fin 3) (o : Fin (r + 1 + 1)),
  kappa (wordFaceKey w τ) o =
    ((↑(Finset.card (Finset.filter (fun j => edgeState w τ j ≠ 0 ∧ parV w j = o) Finset.univ)) +
          if lastV w = o then 1 else 0) -
        if apexV w = o then 1 else 0) -
      ↑(Finset.card (Finset.filter (fun j => edgeState w τ j = 1 ∧ childV w j = o) Finset.univ))
@normalizedKey_kappa_formula : ∀ {r : ℕ} {k : MaxNN.Caterpillar.Corrections.RealKey (r + 1)},
  k ∈ MaxNN.Caterpillar.Corrections.normalizedKeys r →
    ∃ w τ,
      k = wordFaceKey w τ ∧
        ∀ (o : Fin (r + 1 + 1)),
          kappa k o =
            ((↑(Finset.card (Finset.filter (fun j => edgeState w τ j ≠ 0 ∧ parV w j = o) Finset.univ)) +
                  if lastV w = o then 1 else 0) -
                if apexV w = o then 1 else 0) -
              ↑(Finset.card (Finset.filter (fun j => edgeState w τ j = 1 ∧ childV w j = o) Finset.univ))
@card_spine_hingeNbr_le_two : ∀ {r : ℕ} (w : MaxNN.Caterpillar.Corrections.WordIndex r)
  (τ : { x // x ∈ MaxNN.Caterpillar.Corrections.wordLabels w } → Fin 3) (o : Fin (r + 1 + 1)),
  Finset.card (Finset.filter (fun x => HingeNbr (wordFaceKey w τ) o x) (spineV w)) ≤ 2
@kappa_pendant_wordFaceKey : ∀ {r : ℕ} (w : MaxNN.Caterpillar.Corrections.WordIndex r)
  (τ : { x // x ∈ MaxNN.Caterpillar.Corrections.wordLabels w } → Fin 3) (j : Fin r),
  Fin.succ j ∉ ↑w.2 → kappa (wordFaceKey w τ) (childV w j) = if edgeState w τ j = 1 then -1 else 0
@sum_kappa : ∀ {r : ℕ} (k : MaxNN.Caterpillar.Corrections.RealKey (r + 1)),
  (Finset.sum Finset.univ fun o => kappa k o) = ↑(Finset.card (pairSet k))
@keyHead_wordFaceKey : ∀ {r : ℕ} (w : MaxNN.Caterpillar.Corrections.WordIndex r)
  (τ : { x // x ∈ MaxNN.Caterpillar.Corrections.wordLabels w } → Fin 3) (o : Fin (r + 1 + 1)),
  keyHead (wordFaceKey w τ) o =
    (((if lastV w = o then 1 else 0) - if apexV w = o then 1 else 0) +
        Finset.sum Finset.univ fun j =>
          if edgeState w τ j = 1 then (if parV w j = o then 1 else 0) - if childV w j = o then 1 else 0 else 0) +
      Finset.sum Finset.univ fun j =>
        if edgeState w τ j = 2 ∧ childV w j < parV w j then
          (if parV w j = o then 1 else 0) - if childV w j = o then 1 else 0
        else 0
@hasPair_wordFaceKey_iff : ∀ {r : ℕ} (w : MaxNN.Caterpillar.Corrections.WordIndex r)
  (τ : { x // x ∈ MaxNN.Caterpillar.Corrections.wordLabels w } → Fin 3) (a b : Fin (r + 1 + 1)),
  HasPair (wordFaceKey w τ) a b ↔ ∃ j, edgeState w τ j = 2 ∧ lowV w j = a ∧ highV w j = b
@dot_coordT_eq_fullVec : ∀ {n : ℕ} (v : Fin n → ℝ) (y : Fin (n + 1) → ℝ),
  MaxNN.dot v (Matrix.mulVec (MaxNN.ParamidGeom.CoordAux.coordT n) y) =
    Finset.sum Finset.univ fun o => fullVec v o * y o
