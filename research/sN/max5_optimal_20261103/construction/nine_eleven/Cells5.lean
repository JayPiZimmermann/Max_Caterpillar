  linear_combination (1/2 : ℝ) * o0 + (1/2 : ℝ) * o1 + (-1/2 : ℝ) * o2 + (1/2 : ℝ) * o3 + (-1/2 : ℝ) * o4 + (-1/2 : ℝ) * o5 + (-1/2 : ℝ) * o6 + (1/2 : ℝ) * o7 + (-1/2 : ℝ) * o8 + (-1 : ℝ) * q2 + (-1 : ℝ) * q5 + (1 : ℝ) * q6

theorem chamber102 (x : Point 5)
    (c0 : x 2 ≤ x 1) (c1 : x 1 ≤ x 4) (c2 : x 4 ≤ x 0) (c3 : x 0 ≤ x 3) :
    Maximum 5 x = rhs x := by
  rw [max_eq x 3 (by linarith only [c3]) (by linarith only [c1, c2, c3]) (by linarith only [c0, c1, c2, c3]) (le_refl _) (by linarith only [c2, c3])]
