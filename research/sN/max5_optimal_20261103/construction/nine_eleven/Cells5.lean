  have q2 : relu (x 3 - x 0) = -x 0 + x 3 :=
    by convert (relu_eq_self (t := x 3 - x 0) (by linarith only [c3])) using 1 <;> ring
  have q3 : relu (x 4 - x 0) = 0 :=
