@noNegativePair_iff : ∀ {ι : Type u_2} [inst : Fintype ι] (a b : ι → ℝ),
  ∑ i : ι, a i = 0 → ∑ i : ι, b i = 0 → (NoNegativePair a b ↔ a = 0 ∨ b = 0 ∨ ∃ c, 0 < c ∧ ∀ (i : ι), b i = -c * a i)
'MaxCaterpillar.Max5.PairContactDual.noNegativePair_iff' depends on axioms: [propext, Quot.sound, Classical.choice]
