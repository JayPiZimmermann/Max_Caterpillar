shifted_contact_zero : ∀ (i j : Fin 5) (m s t : ℝ),
  0 ≤ s → 0 ≤ t → (invisible fun k => (m - if k = i then s else 0) - if k = j then t else 0) = 0
perturbation_odd_part : ∀ (g : Point 5 → ℝ) (a : ℝ) (x : Point 5),
  g x + a * invisible x - (g (-x) + a * invisible (-x)) = g x - g (-x)
