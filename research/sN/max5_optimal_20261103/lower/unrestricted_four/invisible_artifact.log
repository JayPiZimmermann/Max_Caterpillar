translation_invariant : ∀ (x : Point 5) (t : ℝ), (invisible fun i => x i + t) = invisible x
even : ∀ (x : Point 5), invisible (-x) = invisible x
contact_zero : ∀ (i j : Fin 5) (s t : ℝ), 0 ≤ s → 0 ≤ t → invisible (contact i j s t) = 0
nonzero_witness : invisible ![0, 0, 2, 1, 2] = -1
