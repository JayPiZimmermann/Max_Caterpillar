@convex_of_exact_tangent : ∀ {N m : ℕ} (f : Point N → ℝ) (q : Point N) (e : Fin m ↪ Fin N) (D : Point m → ℝ),
  (∀ (x : Point m), ∀ᶠ (ε : ℝ) in 𝓝[>] 0, f (q + ε • lift e x) = f q + ε * D x) →
    ConvexOn ℝ Set.univ f → ConvexOn ℝ Set.univ D
