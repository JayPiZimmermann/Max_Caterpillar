@explicit_quadratic_ge_one : ∀ {N h₁ h₂ : ℕ} [inst : NeZero N],
  3 ≤ N →
    ∀ (net : Network N h₁ h₂) (C : ℝ),
      1 ≤ C → (∀ (x : Point N), Network.eval net x = Maximum N x) → ↑h₁ ≤ C * ↑N ^ 2 → ↑N ^ 2 / (175000 * C) ≤ ↑h₂
@explicit_quadratic : ∀ {N h₁ h₂ : ℕ} [inst : NeZero N],
  3 ≤ N →
    ∀ (net : Network N h₁ h₂) (C : ℝ),
      0 < C → (∀ (x : Point N), Network.eval net x = Maximum N x) → ↑h₁ ≤ C * ↑N ^ 2 → ↑N ^ 2 / (175000 * max 1 C) ≤ ↑h₂
exists_uniform_quadratic_constant : ∃ c,
  0 < c ∧
    ∀ {N h₁ h₂ : ℕ} [inst : NeZero N],
      3 ≤ N →
        ∀ (net : Network N h₁ h₂) (C : ℝ),
          0 < C → (∀ (x : Point N), Network.eval net x = Maximum N x) → ↑h₁ ≤ C * ↑N ^ 2 → c * ↑N ^ 2 / max 1 C ≤ ↑h₂
exists_quadratic_constant_for_scale : ∀ (C : ℝ),
  0 < C →
    ∃ c,
      0 < c ∧
        ∀ {N h₁ h₂ : ℕ} [inst : NeZero N],
          3 ≤ N →
            ∀ (net : Network N h₁ h₂),
              (∀ (x : Point N), Network.eval net x = Maximum N x) → ↑h₁ ≤ C * ↑N ^ 2 → c * ↑N ^ 2 ≤ ↑h₂
