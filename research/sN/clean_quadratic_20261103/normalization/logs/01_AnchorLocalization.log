@exists_anchor_localized : ∀ {N m h₁ h₂ : ℕ} [inst : NeZero N] [inst_1 : NeZero m] (net : NormalizedNetwork N h₁ h₂),
  TranslationNormalized net →
    (∀ (x : Point N), eval net x = Maximum N x) →
      ∀ (e : Fin m ↪ Fin N),
        ∃ model,
          (∀ (x : Point m), eval model x = Maximum m x) ∧
            TranslationNormalized model ∧
              ∀ (j : Fin h₁),
                A model j = if rowSupport (A net j) ⊆ Finset.image (⇑e) Finset.univ then restrict e (A net j) else 0
