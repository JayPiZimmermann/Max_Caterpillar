@maximum_anchorLift : ∀ {N m : ℕ} [inst : NeZero N] [inst_1 : NeZero m] (e : Fin m ↪ Fin N) (a : Fin m) (q : Point N),
  (∀ (i : Fin m), q (e i) = 0) →
    (∀ i ∉ Finset.image (⇑e) Finset.univ, q i < 0) →
      ∀ (x : Point m) (ε : ℝ), 0 < ε → Maximum N (q + ε • anchorLift e a x) = ε * Maximum m x
@sum_anchorRestrict : ∀ {N m : ℕ} (e : Fin m ↪ Fin N) (a : Fin m) (v : Point N),
  ∑ i : Fin m, anchorRestrict e a v i = ∑ i : Fin N, v i
