@exists_original_matching_of_feeding_braid : ∀ {h₁ h₂ : ℕ} (net : NormalizedNetwork 5 h₁ h₂)
  (hn : TranslationNormalized net),
  (∀ (j : Fin h₁), Feeding net j → Finset.card (rowSupport (A net j)) ≤ 2) →
    (∀ (x : Point 5), eval net x = Maximum 5 x) →
      ∃ k, HasTwoDisjointEdgesOn (braidInteractionGraph net hn k) Finset.univ
@structural_witness_of_generic_embedding_feeding : ∀ {N m h₁ h₂ : ℕ} [inst : NeZero N] (net : NormalizedNetwork N h₁ h₂)
  (hn : TranslationNormalized net),
  (∀ (x : Point N), eval net x = Maximum N x) →
    ∀ (f : Fin 5 ↪ Fin N) (e : Fin m ↪ Fin N) (p : RawConfig m) (T : ℝ),
      Finset.image (⇑e) Finset.univ = Finset.univ \ Finset.image (⇑f) Finset.univ →
        GenericNetworkPoint net e p T →
          (∀ (j : Fin h₁),
              Feeding net j →
                3 ≤ Finset.card (rowSupport (A net j)) → ¬rowSupport (A net j) ⊆ Finset.image (⇑f) Finset.univ) →
            ∃ k,
              NormalizedNetwork.inner net k (actualGapPoint e p T) = 0 ∧
                HasTwoDisjointEdgesOn (braidInteractionGraph net hn k) (Finset.image (⇑f) Finset.univ)
@model_counting_feeding_on_tail : ∀ {m h₁ h₂ : ℕ} (net : NormalizedNetwork (m + 5) h₁ h₂),
  TranslationNormalized net →
    (∀ (x : Point (m + 5)), eval net x = Maximum (m + 5) x) →
      400 ≤ m →
        240 * ActualHalfRestriction.nonBraidCount (core net) ≤ Nat.descFactorial (m + 5) 3 →
          NewCountingTradeoff.CountingPrerequisite 400 ↑m ↑(NetworkLowerBound.regularizedMoment (core net)) ↑h₂
