@forcingEquiv : {V : Type u_1} →
  [inst : DecidableEq V] →
    (p q a b : V) → p ≠ q → a ≠ b → Equiv.Perm V ≃ { σ // σ p = a ∧ σ q = b } × V × { s // s ≠ p }
@forcing_preimage_card : ∀ {V : Type u_1} [inst : DecidableEq V] [inst_1 : Fintype V] (p q a b : V),
  p ≠ q →
    a ≠ b →
      ∀ (σ : { σ // σ p = a ∧ σ q = b }),
        Fintype.card { τ // forcePair τ p q a b = ↑σ } = Fintype.card V * (Fintype.card V - 1)
