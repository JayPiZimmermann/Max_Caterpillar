@exists_affine_quadratic_half_budgets : ∀ {N h₁ h₂ : ℕ} (C : ℕ) (hC : 1 ≤ C)
  (hsize : 10000000000 * quadraticParameter C ^ 2 ≤ N / 2) (net : AffineSkipNetwork N h₁ h₂),
  (∀ (x : Point N), AffineSkipExtension.eval net x = Maximum N x) →
    h₁ ≤ C * N ^ 2 →
      ∃ S,
        Finset.card S = N / 2 ∧
          ∃ model,
            (∀ (x : Point (N / 2)), NormalizedNetwork.eval model x = Maximum (N / 2) x) ∧
              TranslationNormalized model ∧
                ↑(nonBraidCount model) ≤ ↑(quadraticParameter C) ^ 2 * ↑(N / 2) ^ 2 ∧
                  ∑ j : Fin h₁, ↑(Nat.descFactorial (Finset.card (rowSupport (A model j))) 4) ≤
                    ↑(quadraticParameter C) ^ 2 * ↑(N / 2) ^ 2
'MaxCaterpillar.Frontier.RandomRestriction.GrowingMatching.Bernoulli.Affine.exists_affine_quadratic_half_budgets' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
