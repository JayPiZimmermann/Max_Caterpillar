starAnova_all_real : ∀ (z : Fin 4 → ℝ) (t : Fin 80),
  evalForm (starAnovaCoefficients (actualSigns subsetForms z) t) z = 0
starAt_permutation_sum_eq_zero : ∀ (c : Fin 5) (v v' : Fin 5 → ℝ),
  ∑ e : Equiv.Perm (Fin 5), starXi (permutationFunctionChain (starAtSetFunction c v v') e) = 0
@star_network_topMobius_zero : ∀ {ι : Type u_1} [inst : Fintype ι] (center : ι → Fin 5) (v v' : ι → Fin 5 → ℝ)
  (weights : ι → ℝ) (Q : Finset (Fin 5) → ℝ),
  (∀ (p : Fin 120),
      ∃ l β,
        ∀ (x : Point 4),
          (∀ (j : Fin 4), 0 < x j) →
            lin l x + β =
              ∑ i : ι, weights i * relu (lin (setFunctionChain (starAtSetFunction (center i) (v i) (v' i)) p) x)) →
    topMobius Q = 0 →
      (topMobius fun B => ∑ i : ι, weights i * relu (starAtSetFunction (center i) (v i) (v' i) B) + Q B) = 0
@star_network_booleanQuadratic_topMobius_zero : ∀ {ι : Type u_1} [inst : Fintype ι] (center : ι → Fin 5)
  (v v' : ι → Fin 5 → ℝ) (weights : ι → ℝ) (a : ℝ) (b : Fin 5 → ℝ) (d : Fin 5 → Fin 5 → ℝ),
  (∀ (p : Fin 120),
      ∃ l β,
        ∀ (x : Point 4),
          (∀ (j : Fin 4), 0 < x j) →
            lin l x + β =
              ∑ i : ι, weights i * relu (lin (setFunctionChain (starAtSetFunction (center i) (v i) (v' i)) p) x)) →
    (topMobius fun B =>
        ∑ i : ι, weights i * relu (starAtSetFunction (center i) (v i) (v' i) B) + booleanQuadratic a b d B) =
      0
@star_network_booleanQuadratic_not_booleanOR : ∀ {ι : Type u_1} [inst : Fintype ι] (center : ι → Fin 5)
  (v v' : ι → Fin 5 → ℝ) (weights : ι → ℝ) (a : ℝ) (b : Fin 5 → ℝ) (d : Fin 5 → Fin 5 → ℝ),
  (∀ (p : Fin 120),
      ∃ l β,
        ∀ (x : Point 4),
          (∀ (j : Fin 4), 0 < x j) →
            lin l x + β =
              ∑ i : ι, weights i * relu (lin (setFunctionChain (starAtSetFunction (center i) (v i) (v' i)) p) x)) →
    ¬∀ (B : Finset (Fin 5)),
        ∑ i : ι, weights i * relu (starAtSetFunction (center i) (v i) (v' i) B) + booleanQuadratic a b d B = booleanOR B
