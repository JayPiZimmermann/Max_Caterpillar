@exact_transport_contract : ∀ {m n q : ℕ} (G : SimpleGraph (Fin n)) [inst : DecidableRel G.Adj] (f : Fin m ↪ Fin n),
  ∀ B ∈ matchings (SimpleGraph.comap (⇑f) G) q,
    ∃ C ⊆ SimpleGraph.edgeFinset G,
      Finset.card C = q ∧
        (∀ e ∈ C, ∀ e' ∈ C, e ≠ e' → Disjoint (GraphRestriction.edgeVertices e) (GraphRestriction.edgeVertices e')) ∧
          GraphRestriction.pairVertices C ⊆ Finset.image (⇑f) Finset.univ
@exact_event_contract : ∀ {m n k q : ℕ} (G : SimpleGraph (Fin n)) [inst : DecidableRel G.Adj] (f : Fin m ↪ Fin n),
  ∀ B ∈ matchings (SimpleGraph.comap (⇑f) G) q,
    ∀ (σ : Equiv.Perm (Fin n)), (∀ (i : Fin m), ↑(σ (f i)) < k) → σ ∈ selectedEvent G k q
'GrowingMatchingTransportCheck.exact_transport_contract' depends on axioms: [propext, Quot.sound, Classical.choice]
