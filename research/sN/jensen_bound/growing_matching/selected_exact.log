@exact_card_contract : ∀ {n k q : ℕ} (G : SimpleGraph (Fin n)) [inst : DecidableRel G.Adj],
  k ≤ n →
    Nat.factorial q * (Finset.card (selectedEvent G k q) * Nat.descFactorial n (2 * q)) ≤
      Finset.card (SimpleGraph.edgeFinset G) ^ q * (Nat.descFactorial k (2 * q) * Fintype.card (Equiv.Perm (Fin n)))
@exact_fraction_contract : ∀ {n k q : ℕ} (G : SimpleGraph (Fin n)) [hG : DecidableRel G.Adj],
  k ≤ n →
    ↑(Finset.card
            (Finset.filter
              (fun σ =>
                ∃ B ⊆ SimpleGraph.edgeFinset G,
                  Finset.card B = q ∧
                    (∀ e ∈ B,
                        ∀ f ∈ B, e ≠ f → Disjoint (GraphRestriction.edgeVertices e) (GraphRestriction.edgeVertices f)) ∧
                      GraphRestriction.pairVertices B ⊆ GoodEvent.smallRankGaps σ k)
              Finset.univ)) /
        ↑(Fintype.card (Equiv.Perm (Fin n))) ≤
      ↑(Finset.card (SimpleGraph.edgeFinset G)) ^ q / ↑(Nat.factorial q) *
        (↑(Nat.descFactorial k (2 * q)) / ↑(Nat.descFactorial n (2 * q)))
