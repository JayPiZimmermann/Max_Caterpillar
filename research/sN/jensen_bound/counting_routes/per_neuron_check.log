@firstSupports : {m h₁ h₂ : ℕ} → NormalizedNetwork (m + 5) h₁ h₂ → Fin h₁ → Finset (Fin (m + 5))
@actualPoint : {m : ℕ} → Configuration m → ℝ → Point (m + 5)
@neuronEvent : {m h₁ h₂ : ℕ} →
  (net : NormalizedNetwork (m + 5) h₁ h₂) →
    NormalizedNetwork.TranslationNormalized net → ℕ → ℝ → Fin h₂ → Finset (Configuration m)
@UniformGapScale : {m h₁ h₂ : ℕ} → NormalizedNetwork (m + 5) h₁ h₂ → ℝ → Prop
@neuron_event_card_le_four_hundred : ∀ {m h₁ h₂ : ℕ} (net : NormalizedNetwork (m + 5) h₁ h₂)
  (hn : NormalizedNetwork.TranslationNormalized net) (K : ℕ) (T : ℝ) (k : Fin h₂),
  400 ≤ m →
    4 ≤ K →
      ↑K ≤ ↑m / 100 →
        UniformGapScale net T → K ^ 2 * Finset.card (neuronEvent net hn K T k) ≤ 400 * Fintype.card (Configuration m)
@exists_neuron_event_counting_threshold : ∀ {m h₁ h₂ : ℕ} (net : NormalizedNetwork (m + 5) h₁ h₂)
  (hn : NormalizedNetwork.TranslationNormalized net),
  ∃ B,
    2 ≤ B ∧
      ∀ (T : ℝ),
        B ≤ T →
          ∀ (K : ℕ) (k : Fin h₂),
            400 ≤ m →
              4 ≤ K →
                ↑K ≤ ↑m / 100 → K ^ 2 * Finset.card (neuronEvent net hn K T k) ≤ 400 * Fintype.card (Configuration m)
