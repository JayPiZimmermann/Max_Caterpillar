@selectedTailMean : {m n : ℕ} →
  (G : SimpleGraph (Fin n)) → [inst : DecidableRel G.Adj] → (Equiv.Perm (Fin n) → SimpleGraph (Fin m)) → ℕ → ℕ → ℕ → ℝ
@actualNeuronEvent : {k m h₁ h₂ : ℕ} →
  (net : NormalizedNetwork (m + k) h₁ h₂) →
    NormalizedNetwork.TranslationNormalized net → ℕ → ℕ → ℝ → Fin h₂ → Finset (Configuration k m)
@CommonGapScale : {k m h₁ h₂ : ℕ} → NormalizedNetwork (m + k) h₁ h₂ → ℝ → Prop
@actualNeuron_fraction_le : ∀ {k m h₁ h₂ : ℕ} (net : NormalizedNetwork (m + k) h₁ h₂)
  (hn : NormalizedNetwork.TranslationNormalized net) (q K : ℕ) (T : ℝ) (r : Fin h₂),
  CommonGapScale net T →
    2 ≤ m →
      0 < ↑K →
        ↑(Finset.card (actualNeuronEvent net hn q K T r)) / ↑(Fintype.card (Configuration k m)) ≤
          ↑(Nat.descFactorial k (2 * q)) / ↑(Nat.descFactorial (m + k) (2 * q)) * (tailRate m K ^ q)⁻¹ *
            Real.exp (tailRate m K * (↑k * (↑m + ↑k - 1)))
