parameter_bounds : ∀ (n d : ℕ), 1 ≤ d → 10000000000 * d ^ 2 ≤ n → ParameterBounds n d
@coverage_from_explicit_budgets : ∀ {n d : ℕ},
  1 ≤ d →
    10000000000 * d ^ 2 ≤ n →
      ∀ (M L bsize bgood bshort : ℝ),
        M ≤ ↑d ^ 2 * ↑n ^ 2 →
          0 ≤ L →
            L ≤ ↑d ^ 2 * ↑n ^ 2 →
              bsize ≤
                  Real.exp (-3 * bernoulliMean n d / 40) /
                    (Real.exp (-2 * M * selectionProbability n d ^ 3) - Real.exp (-bernoulliMean n d / 3)) →
                bgood ≤ supportBudget n d L →
                  bshort ≤ 8 * ↑(rankCount n d) / ↑(minimumTail n d) → 9 / 10 ≤ 1 - bsize - bgood - bshort
@conditional_width_bound : ∀ {n d : ℕ},
  1 ≤ d →
    10000000000 * d ^ 2 ≤ n →
      ∀ (h₂ : ℕ), 9 / 10 ≤ ↑h₂ * neuronEnvelope n d → 1 / 2 * Real.exp (3 * Real.sqrt ↑n / (8000 * ↑d)) ≤ ↑h₂
