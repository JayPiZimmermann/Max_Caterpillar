@conditional_braid_sqrt_floor_lower_bound : ∀ {n h₁ h₂ : ℕ} (hN : 160000 ≤ n),
  LocalMatchingObstruction (braidArity ⌊Real.sqrt ↑n / 400⌋₊) ⌊Real.sqrt ↑n / 400⌋₊ →
