@badFirstEvent_fraction_le : ∀ {n k : ℕ} {κ : Type u_2} [inst : Fintype κ],
  k ≤ n →
    3 ≤ n →
      ∀ (T : κ → Finset (Fin n)),
        ↑(Finset.card (badFirstEvent k T)) / ↑(Fintype.card (Equiv.Perm (Fin n))) ≤
          ↑(largeSupportCount T) * ↑(Nat.descFactorial k 3) / ↑(Nat.descFactorial n 3)
@configurationBadFirstEvent_fraction_le : ∀ {κ : Type u_2} [inst : Fintype κ] (k m : ℕ),
  3 ≤ m + k →
    ∀ (T : κ → Finset (Fin (m + k))),
      ↑(Finset.card (configurationBadFirstEvent k m T)) / ↑(Fintype.card (Configurations.Configuration k m)) ≤
        ↑(largeSupportCount T) * ↑(Nat.descFactorial k 3) / ↑(Nat.descFactorial (m + k) 3)
