@conditional_affine_coin_card_mul : ∀ {ι : Type u_8} {Ω : Type u_7} {Data : Type u_6} {V : Type u_5} [inst : Fintype ι]
  [inst_1 : DecidableEq ι] [inst_2 : Fintype Ω] [inst_3 : AddCommGroup V] [inst_4 : Module ℝ V] (recorded : Ω → Data)
  (coins : Ω → ι → Bool),
  CoinFlipSystem recorded coins →
    ∀ (d : Data) (offset target : V) (columns : ι → V) (s : Finset ι),
      (LinearIndependent ℝ fun i => columns ↑i) →
        Finset.card (coinEventFiber recorded coins d (affineCoinSolutions offset target columns)) * 2 ^ Finset.card s ≤
          Finset.card (dataFiber recorded d)
@conditional_affine_coin_fraction_le : ∀ {ι : Type u_8} {Ω : Type u_7} {Data : Type u_6} {V : Type u_5}
  [inst : Fintype ι] [inst_1 : DecidableEq ι] [inst_2 : Fintype Ω] [inst_3 : AddCommGroup V] [inst_4 : Module ℝ V]
  (recorded : Ω → Data) (coins : Ω → ι → Bool),
  CoinFlipSystem recorded coins →
    ∀ (d : Data),
      0 < Finset.card (dataFiber recorded d) →
        ∀ (offset target : V) (columns : ι → V) (s : Finset ι),
          (LinearIndependent ℝ fun i => columns ↑i) →
            ↑(Finset.card (coinEventFiber recorded coins d (affineCoinSolutions offset target columns))) /
                ↑(Finset.card (dataFiber recorded d)) ≤
              1 / 2 ^ Finset.card s
