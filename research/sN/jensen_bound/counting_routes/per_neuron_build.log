@affine_from_flip_differences : ∀ {ι : Type u_4} {V : Type u_3} [inst : Fintype ι] [inst_1 : DecidableEq ι]
  [inst_2 : AddCommGroup V] [inst_3 : Module ℝ V] {m : ℕ} (slot : ι × Bool ↪ Fin m) (u : Data ι m)
  (F : Fiber slot u → V) (columns : ι → V) (base : Fiber slot u),
  (∀ (i : ι) (p : Fiber slot u),
      F ((fiberFlip slot u i) p) - F p =
        ((coinCoefficient !fiberCoins slot u p i) - coinCoefficient (fiberCoins slot u p i)) • columns i) →
    ∀ (p : Fiber slot u),
      F p =
        affineCoinEval (F base - ∑ j : ι, coinCoefficient (fiberCoins slot u base j) • columns j) columns
          (fiberCoins slot u p)
