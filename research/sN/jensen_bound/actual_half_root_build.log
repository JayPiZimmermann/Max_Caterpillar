[4144/4146] Building MaxCaterpillar.Frontier.RandomRestriction.ActualHalfRestriction.Model
stdout:
@exists_actual_model : ∀ {N n h₁ h₂ : ℕ} [inst : NeZero N] [inst_1 : NeZero n] (net : Network N h₁ h₂),
  (∀ (x : Point N), Network.eval net x = Maximum N x) →
    2 * n ≤ N →
      ∃ S,
        Finset.card S = n ∧
          ∃ model,
            (∀ (x : Point n), eval model x = Maximum n x) ∧
              TranslationNormalized model ∧
                4 * fourthMoment model ≤ 81 * h₁ ∧
                  4 * nonBraidCount model ≤ h₁ ∧ 4 * max (fourthMoment model) 1 ≤ 81 * h₁
@exists_actual_half_model : ∀ {N h₁ h₂ : ℕ} [inst : NeZero N] (hN : 1040 ≤ N) (net : Network N h₁ h₂),
  (∀ (x : Point N), Network.eval net x = Maximum N x) →
    ∃ S,
      Finset.card S = N / 2 ∧
        ∃ model,
          (∀ (x : Point (N / 2)), eval model x = Maximum (N / 2) x) ∧
            TranslationNormalized model ∧
              4 * fourthMoment model ≤ 81 * h₁ ∧ 4 * nonBraidCount model ≤ h₁ ∧ 4 * max (fourthMoment model) 1 ≤ 81 * h₁
