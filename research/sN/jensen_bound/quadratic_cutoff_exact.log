@QuadraticCutoff.model_bound : ∀ {m h₁ h₂ : ℕ},
  20000 ≤ m →
    ∀ (net : NormalizedNetwork (m + 5) h₁ h₂),
      NormalizedNetwork.TranslationNormalized net →
        (∀ (x : Point (m + 5)), NormalizedNetwork.eval net x = Maximum (m + 5) x) →
          ↑(RandomRestriction.BadFirst.largeSupportCount (firstSupports net)) ≤ 2 * ↑m ^ 2 →
            ∑ j : Fin h₁, ↑(Nat.descFactorial (Finset.card (firstSupports net j)) 4) ≤ 100 * ↑m ^ 2 →
              ↑m ^ 2 / 2163200 ≤ ↑h₂
@QuadraticCutoff.normalized_quadratic : ∀ {N h₁ h₂ : ℕ} [inst : NeZero N],
  3 ≤ N →
    ∀ (net : NormalizedNetwork N h₁ h₂),
      NormalizedNetwork.TranslationNormalized net →
        (∀ (x : Point N), NormalizedNetwork.eval net x = Maximum N x) → ↑h₁ ≤ ↑N ^ 2 → 1 / 10000000 * ↑N ^ 2 ≤ ↑h₂
@QuadraticCutoff.affine_quadratic : ∀ {N h₁ h₂ : ℕ} (hN : 3 ≤ N) (net : AffineSkipNetwork N h₁ h₂),
  (∀ (x : Point N), eval net x = Maximum N x) → ↑h₁ ≤ ↑N ^ 2 → 1 / 10000000 * ↑N ^ 2 ≤ ↑h₂
