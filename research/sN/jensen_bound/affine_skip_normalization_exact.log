@exists_normalizedModel : ∀ {N h₁ h₂ : ℕ} [inst : NeZero N] (net : AffineSkipNetwork N h₁ h₂),
  (∀ (x : Point N), eval net x = Maximum N x) →
    ∃ model,
      (∀ (x : Point N), NormalizedNetwork.eval model x = Maximum N x) ∧
        NormalizedNetwork.TranslationNormalized model ∧
          (∀ (j : Fin h₁),
              NormalizedNetwork.A model j =
                if AffineSkipNetwork.b net j = 0 ∧ ∑ i : Fin N, AffineSkipNetwork.A net j i = 0 then
                  AffineSkipNetwork.A net j
                else 0) ∧
            ∀ (j : Fin h₁), NormalizedNetwork.Feeding model j → ∃ k, AffineSkipNetwork.W net k j ≠ 0
