@normalized_width_binomial_sharp_feeding : ∀ {N h₁ h₂ : ℕ} [inst : NeZero N] (net : NormalizedNetwork N h₁ h₂)
  (hn : TranslationNormalized net),
  (∀ (x : Point N), NormalizedNetwork.eval net x = Maximum N x) →
    (∀ (k : Fin h₂) (j : Fin h₁), W net k j ≠ 0 → Finset.card (rowSupport (A net j)) ≤ 2) →
      (∀ (k : Fin h₂) (v : Fin N), SimpleGraph.degree (braidInteractionGraph net hn k) v ≤ 2) →
        ∀ (m : ℕ), 3 ≤ m → 2 * Nat.choose N m ≤ h₂ * (2 * N + (m - 1) * N ^ 2)
@raw_width_binomial_sharp : ∀ {N h₁ h₂ : ℕ} [inst : NeZero N] (net : AffineSkipNetwork N h₁ h₂),
  (∀ (x : Point N), AffineSkipExtension.eval net x = Maximum N x) →
    ∀ (hA : ∀ (j : Fin h₁), ∑ i : Fin N, AffineSkipNetwork.A net j i = 0),
      (∀ (j : Fin h₁), Finset.card (rowSupport (AffineSkipNetwork.A net j)) ≤ 2) →
        (∀ (k : Fin h₂) (v : Fin N),
            SimpleGraph.degree (ExponentialPush.DegreeTwo.Recession.rawInteractionGraph net hA k) v ≤ 2) →
          ∀ (m : ℕ), 3 ≤ m → 2 * Nat.choose N m ≤ h₂ * (2 * N + (m - 1) * N ^ 2)
@raw_width_exponential_sharp_real : ∀ {N h₁ h₂ : ℕ} [inst : NeZero N],
  6 ≤ N →
    ∀ (net : AffineSkipNetwork N h₁ h₂),
      (∀ (x : Point N), AffineSkipExtension.eval net x = Maximum N x) →
        ∀ (hA : ∀ (j : Fin h₁), ∑ i : Fin N, AffineSkipNetwork.A net j i = 0),
          (∀ (j : Fin h₁), Finset.card (rowSupport (AffineSkipNetwork.A net j)) ≤ 2) →
            (∀ (k : Fin h₂) (v : Fin N),
                SimpleGraph.degree (ExponentialPush.DegreeTwo.Recession.rawInteractionGraph net hA k) v ≤ 2) →
              4 * 2 ^ N / (↑N ^ 3 * (↑N + 1)) ≤ ↑h₂
