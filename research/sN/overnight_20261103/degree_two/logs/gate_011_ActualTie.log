@exists_active_second_on_embedding : ∀ {N m h₁ h₂ : ℕ} [inst : NeZero N] [inst_1 : NeZero m],
  3 ≤ m →
    ∀ (net : NormalizedNetwork N h₁ h₂) (hn : TranslationNormalized net),
      (∀ (j : Fin h₁), Finset.card (rowSupport (A net j)) ≤ 2) →
        (∀ (x : Point N), eval net x = Maximum N x) →
          ∀ (f : Fin m ↪ Fin N),
            ∃ r,
              d net r ≠ 0 ∧
                Nat.card (SimpleGraph.ConnectedComponent (SimpleGraph.comap (⇑f) (braidInteractionGraph net hn r))) ≤ 2
@exists_active_second_on_set : ∀ {N h₁ h₂ : ℕ} [inst : NeZero N] (net : NormalizedNetwork N h₁ h₂)
  (hn : TranslationNormalized net),
  (∀ (j : Fin h₁), Finset.card (rowSupport (A net j)) ≤ 2) →
    (∀ (x : Point N), eval net x = Maximum N x) →
      ∀ (S : Finset (Fin N)),
        3 ≤ Finset.card S →
          ∃ r,
            d net r ≠ 0 ∧
              Nat.card (SimpleGraph.ConnectedComponent (SimpleGraph.induce (↑S) (braidInteractionGraph net hn r))) ≤ 2
