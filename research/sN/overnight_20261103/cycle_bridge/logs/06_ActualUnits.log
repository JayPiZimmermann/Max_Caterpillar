@actual_neuron_forest_expansion : ∀ {N h₁ h₂ : ℕ} (net : NormalizedNetwork N h₁ h₂),
  TranslationNormalized net →
    (∀ (j : Fin h₁), Finset.card (rowSupport (A net j)) ≤ 2) →
      ∀ (k : Fin h₂),
        ∃ d,
          ∀ (x : Point N),
            relu (NormalizedNetwork.inner net k x) =
              ∑ t : UnitState net k,
                d t *
                  relu
                    (lin (stateHead net k ↑t) x +
                      ∑ p : Pair N, stateWeight net k (↑t) p * relu (lin (braidRoot (left p) (right p)) x))
