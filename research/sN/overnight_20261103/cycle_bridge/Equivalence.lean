import research.sN.overnight_20261103.cycle_bridge.ExpandedGraphs
import research.sN.overnight_20261103.cycle_bridge.MatchingCover
import MaxCaterpillar.Frontier.RandomRestriction.GrowingMatching.Structural

/-! Exact equality of the finite representable function classes generated by
matching-bounded and cover-bounded actual braid networks, at the same arity.
The hidden widths may change. -/
set_option autoImplicit false
noncomputable section
namespace MaxCaterpillar.ExponentialPush.CycleBridge
open Frontier Frontier.RandomRestriction NormalizedNetwork
open ForestMatching GrowingMatching DictionaryBridge ActualBraid
attribute [local instance] Classical.propDecidable

/-- An actual finite normalized braid network, all of whose original
interaction graphs have matching number at most r. -/
def MatchingRepresentable (N r : ℕ) (f : Point N → ℝ) : Prop :=
  ∃ (h₁ h₂ : ℕ) (net : NormalizedNetwork N h₁ h₂)
    (hn : net.TranslationNormalized),
    (∀ j, (rowSupport (net.A j)).card ≤ 2) ∧
    (∀ x, net.eval x = f x) ∧
    ∀ k : Fin h₂, ¬ ∃ B, B ∈ matchings (braidInteractionGraph net hn k) (r+1)

/-- An actual finite normalized braid network, with an endpoint cover of
size at most r for every original second-hidden interaction graph. -/
def CoverRepresentable (N r : ℕ) (f : Point N → ℝ) : Prop :=
  ∃ (h₁ h₂ : ℕ) (net : NormalizedNetwork N h₁ h₂)
    (hn : net.TranslationNormalized),
    (∀ j, (rowSupport (net.A j)).card ≤ 2) ∧
    (∀ x, net.eval x = f x) ∧
    ∀ k : Fin h₂, ∃ C : Finset (Fin N),
      IsVertexCover (braidInteractionGraph net hn k) C ∧ C.card ≤ r

/-- Exact same-arity finite-network equivalence, with all signed weights,
linear heads, braid output skips, and parallel-row cancellations retained.
This does not preserve the second hidden width. -/
theorem matchingRepresentable_iff_coverRepresentable (N r : ℕ)
    (f : Point N → ℝ) : MatchingRepresentable N r f ↔ CoverRepresentable N r f := by
  constructor
  · rintro ⟨h₁,h₂,net,hn,hc,he,hno⟩
    obtain ⟨d,hd⟩ := exists_expansion net hn hc
    let hnew := expanded_translationNormalized net hn hc d
    refine ⟨_,_,expandedNetwork net d,hnew,expanded_support_le_two net d,?_,?_⟩
    · intro x
      exact (hd x).trans (he x)
    · exact expanded_small_covers net hn r hno d hnew
  · rintro ⟨h₁,h₂,net,hn,hc,he,hcover⟩
    refine ⟨h₁,h₂,net,hn,hc,he,?_⟩
    intro k
    obtain ⟨C,hC,hsize⟩ := hcover k
    exact no_matching_of_small_cover _ C hC hsize

theorem localMatchingObstruction_iff_no_matching_representation (N r : ℕ) [NeZero N] :
    LocalMatchingObstruction N (r+1) ↔ ¬ MatchingRepresentable N r (Maximum N) := by
  constructor
  · intro H
    rintro ⟨h₁,h₂,net,hn,hc,he,hno⟩
    obtain ⟨k,B,hB,_⟩ := H h₁ h₂ net hn hc he
    exact hno k ⟨B,hB⟩
  · intro H h₁ h₂ net hn hc he
    by_contra hnot
    apply H
    refine ⟨h₁,h₂,net,hn,hc,he,?_⟩
    intro k
    rintro ⟨B,hB⟩
    exact hnot ⟨k,B,hB,Finset.subset_univ _⟩

/-- The sole structural obstruction required by growing-matching counting
is equivalent to excluding cover-r actual networks on the SAME N inputs. -/
theorem localMatchingObstruction_iff_no_cover_representation (N r : ℕ) [NeZero N] :
    LocalMatchingObstruction N (r+1) ↔ ¬ CoverRepresentable N r (Maximum N) := by
  rw [localMatchingObstruction_iff_no_matching_representation,
    matchingRepresentable_iff_coverRepresentable]

/-- A direct theorem schema usable without the representability predicates.
The cover premise ranges over actual networks, not arbitrary set functions. -/
theorem localMatchingObstruction_of_cover_obstruction (N r : ℕ) [NeZero N]
    (H : ∀ (h₁ h₂ : ℕ) (net : NormalizedNetwork N h₁ h₂)
      (hn : net.TranslationNormalized),
      (∀ j, (rowSupport (net.A j)).card ≤ 2) →
      (∀ x, net.eval x = Maximum N x) →
      (∀ k : Fin h₂, ∃ C : Finset (Fin N),
        IsVertexCover (braidInteractionGraph net hn k) C ∧ C.card ≤ r) → False) :
    LocalMatchingObstruction N (r+1) := by
  apply (localMatchingObstruction_iff_no_cover_representation N r).mpr
  rintro ⟨h₁,h₂,net,hn,hc,he,hcover⟩
  exact H h₁ h₂ net hn hc he hcover

#check @matchingRepresentable_iff_coverRepresentable
#check @localMatchingObstruction_iff_no_cover_representation
#print axioms matchingRepresentable_iff_coverRepresentable
#print axioms localMatchingObstruction_iff_no_cover_representation
#print axioms localMatchingObstruction_of_cover_obstruction
end MaxCaterpillar.ExponentialPush.CycleBridge
