@conditional_affine_sqrt_coefficient : ∀ {N h₁ h₂ : ℕ} (C : ℕ) (hsize : 10000000000 * (10 * sqrtCeiling C) ^ 2 ≤ N / 2),
  LocalMatchingObstruction (Bernoulli.Parameters.minimumArity (N / 2) (10 * sqrtCeiling C))
      (Bernoulli.Parameters.matchingOrder (N / 2) (10 * sqrtCeiling C)) →
    ∀ (net : AffineSkipNetwork N h₁ h₂),
      (∀ (x : Point N), eval net x = Maximum N x) →
        h₁ ≤ C * N ^ 2 → 1 / 2 * Real.exp (3 * Real.sqrt ↑(N / 2) / (80000 * ↑(sqrtCeiling C))) ≤ ↑h₂
