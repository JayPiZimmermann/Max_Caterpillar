@exists_feeding_weighted_model : ∀ {N n h₁ h₂ : ℕ} [inst : NeZero N] [inst_1 : NeZero n]
  (net : NormalizedNetwork N h₁ h₂),
  TranslationNormalized net →
    (∀ (x : Point N), eval net x = Maximum N x) →
      2 * n ≤ N →
        ∀ (cost : ℕ → ℝ),
          cost 0 = 0 →
            (∀ (r : ℕ), 0 ≤ cost r) →
              ∃ S,
                Finset.card S = n ∧
                  ∃ model,
                    (∀ (x : Point n), eval model x = Maximum n x) ∧
                      TranslationNormalized model ∧
                        ∑ j : Fin h₁, cost (Finset.card (rowSupport (A (core model) j))) ≤ feedingSupportBudget cost net
'MaxCaterpillar.ExponentialPush.WeightedSupport.exists_weighted_model' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
