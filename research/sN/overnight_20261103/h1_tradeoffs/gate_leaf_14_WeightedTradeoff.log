@conditional_affine_support_tradeoff : ∀ {N h₁ h₂ : ℕ} (d : ℕ) (hd : 1 ≤ d) (hsize : 10000000000 * d ^ 2 ≤ N / 2),
  LocalMatchingObstruction (Parameters.minimumArity (N / 2) d) (Parameters.matchingOrder (N / 2) d) →
    ∀ (net : AffineSkipNetwork N h₁ h₂),
      (∀ (x : Point N), AffineSkipExtension.eval net x = Maximum N x) →
        originalSupportBudget (N / 2) net ≤ ↑d ^ 2 * ↑(N / 2) ^ 2 →
          1 / 2 * Real.exp (3 * Real.sqrt ↑(N / 2) / (8000 * ↑d)) ≤ ↑h₂
'MaxCaterpillar.ExponentialPush.WidthTradeoff.budgets_of_support_cost' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
'MaxCaterpillar.ExponentialPush.WidthTradeoff.conditional_affine_support_tradeoff' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
