@exists_half_weighted_restriction : ∀ {κ : Type u_3} [inst : Fintype κ] {N n : ℕ},
  2 * n ≤ N →
    ∀ (T : κ → Finset (Fin N)) (cost : ℕ → ℝ),
      cost 0 = 0 →
        (∀ (r : ℕ), 0 ≤ cost r) →
          ∃ U,
            Finset.card U = n ∧
              (∑ j : κ, if T j ⊆ U then cost (Finset.card (T j)) else 0) ≤
                ∑ j : κ, cost (Finset.card (T j)) / 2 ^ Finset.card (T j)
