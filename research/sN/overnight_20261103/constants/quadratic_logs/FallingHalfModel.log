@exists_model : ∀ {N n h₁ h₂ : ℕ} [inst : NeZero N] [inst_1 : NeZero n] (net : NormalizedNetwork N h₁ h₂),
  TranslationNormalized net →
    (∀ (x : Point N), eval net x = Maximum N x) →
      2 * n ≤ N →
        ∃ S,
          Finset.card S = n ∧
            ∃ model,
              (∀ (x : Point n), eval model x = Maximum n x) ∧
                TranslationNormalized model ∧
                  16 * ∑ j : Fin h₁, Nat.descFactorial (Finset.card (rowSupport (A model j))) 4 ≤ 105 * h₁
'MaxCaterpillar.Overnight.Constants.FallingHalf.exists_half_support_falling' depends on axioms: [propext,
 Quot.sound,
 Classical.choice]
'MaxCaterpillar.Overnight.Constants.FallingHalf.exists_model' depends on axioms: [propext, Classical.choice, Quot.sound]
