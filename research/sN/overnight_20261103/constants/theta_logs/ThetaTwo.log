@highSelectedTailMean_le_two : ∀ {m n : ℕ} (G : SimpleGraph (Fin n)) [inst : DecidableRel G.Adj]
  (H : Equiv.Perm (Fin n) → SimpleGraph (Fin m)) [hH : (σ : Equiv.Perm (Fin n)) → DecidableRel (H σ).Adj] (k K : ℕ)
  (d : ℝ),
  k ≤ n →
    2 ≤ m →
      0 < ↑K →
        (∀ (σ : Equiv.Perm (Fin n)),
            ↑(Finset.card (SimpleGraph.edgeFinset G)) - d ≤ ↑(Finset.card (SimpleGraph.edgeFinset (H σ)))) →
          highSelectedTailMean G H k K ≤
            2 / 7 * (↑(Nat.descFactorial k 4) / ↑(Nat.descFactorial n 4)) * (highTailRate m K ^ 2)⁻¹ *
              Real.exp (highTailRate m K * d)
